<%- include('partials/head') %>
<body class="bg-background min-h-screen">
    <!-- Navigation Shared Partials -->
    <%- include('partials/sidebar') %>
    <%- include('partials/header') %>

    <!-- Main Content Canvas -->
    <main class="pt-24 pb-20 px-margin-mobile md:px-margin-desktop lg:pl-[280px] min-h-screen">
        <div class="max-w-[1440px] mx-auto w-full space-y-xl animate-fade-in">
            <!-- Header Section -->
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                <div>
                    <h3 class="font-headline-lg text-headline-lg text-on-surface">Classrooms Directory</h3>
                    <p class="text-on-surface-variant font-body-md">Manage academic course divisions and track live student enrollments</p>
                </div>
                <div class="flex items-center gap-3 flex-wrap">
                    <button onclick="toggleJoinModal(true)" class="flex items-center gap-2 px-4 py-2.5 bg-surface-container text-on-surface rounded-xl font-bold border border-outline-variant/40 hover:bg-surface-container-high active:scale-95 transition-all">
                        <span class="material-symbols-outlined text-sm">key</span> Join via Code
                    </button>
                    <button onclick="toggleCreateClassroomModal(true)" class="flex items-center gap-2 px-5 py-2.5 bg-primary text-white rounded-xl font-bold shadow-md hover:shadow-lg active:scale-95 transition-all hover:scale-105">
                        <span class="material-symbols-outlined text-sm">add</span> Create Classroom
                    </button>
                </div>
            </div>

            <!-- Classrooms Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-gutter" id="classroomsGrid">
                <% if (classrooms.length === 0) { %>
                    <div class="col-span-full text-center py-12 flex flex-col items-center gap-4 bg-white rounded-2xl border border-outline-variant/30">
                        <span class="material-symbols-outlined text-[48px] text-on-surface-variant/30">school</span>
                        <div>
                            <h5 class="text-lg font-bold text-on-surface">No Classrooms Available</h5>
                            <p class="text-on-surface-variant text-sm mt-1">Add your first academic classroom or join an existing division via join code.</p>
                        </div>
                        <div class="flex items-center gap-3">
                            <button onclick="toggleJoinModal(true)" class="px-5 py-2 bg-surface-container text-on-surface font-bold rounded-xl shadow-sm text-sm">
                                Join via Code
                            </button>
                            <button onclick="toggleCreateClassroomModal(true)" class="px-5 py-2 bg-primary text-white font-bold rounded-xl shadow-sm hover:brightness-110 active:scale-95 transition-all text-sm">
                                Add Classroom
                            </button>
                        </div>
                    </div>
                <% } else { %>
                    <% classrooms.forEach(room => { %>
                        <div class="classroom-card bg-white rounded-2xl border border-outline-variant/30 p-6 flex flex-col justify-between shadow-sm hover-scale relative overflow-hidden">
                            <div class="absolute top-3 right-3 flex items-center gap-2">
                                <% if (room.hasLivePoll) { %>
                                    <span class="flex items-center gap-1.5 px-2.5 py-0.5 bg-error-container text-on-error-container rounded-full animate-pulse text-xs font-bold uppercase">
                                        <span class="material-symbols-outlined text-[10px]" style="font-variation-settings: 'FILL' 1;">live_tv</span> Active
                                    </span>
                                <% } %>
                                <button onclick="deleteClassroom('<%= room._id %>')" class="p-1 text-on-surface-variant hover:text-error hover:bg-error-container/20 rounded transition-all z-20">
                                    <span class="material-symbols-outlined text-sm">delete</span>
                                </button>
                            </div>

                            <div>
                                <h4 class="font-headline-md text-headline-md font-bold text-on-surface leading-tight"><%= room.name %></h4>
                                <p class="text-primary font-bold text-sm mt-1 truncate"><%= room.subject %></p>
                                <p class="text-xs text-on-surface-variant mt-2 font-medium"><%= room.department %> • Section <%= room.section || 'A' %> • <%= room.year %> • <%= room.semester %></p>
                                <p class="text-xs text-on-surface-variant/75 mt-3 line-clamp-2"><%= room.description || 'No description provided.' %></p>
                            </div>

                            <div class="mt-6 pt-4 border-t border-outline-variant/20 flex justify-between items-center">
                                <div class="space-y-0.5">
                                    <p class="text-[10px] uppercase font-bold text-on-surface-variant/65">Join Code</p>
                                    <div class="flex items-center gap-1">
                                        <code class="font-mono text-xs bg-surface-container px-2 py-0.5 border border-outline-variant/10 rounded font-bold text-primary"><%= room.joinCode || room.code %></code>
                                        <button onclick="copyToClipboard('<%= room.joinCode || room.code %>', this)" class="p-1 text-on-surface-variant hover:text-primary rounded hover:bg-surface-container transition-all relative">
                                            <span class="material-symbols-outlined text-sm">content_copy</span>
                                        </button>
                                    </div>
                                </div>
                                <div class="flex items-center gap-4 text-right">
                                    <div>
                                        <p class="text-lg font-black text-on-surface"><%= (room.students || []).length %> / <%= room.studentCapacity || 63 %></p>
                                        <p class="text-[9px] uppercase font-bold text-on-surface-variant">Students</p>
                                    </div>
                                    <div>
                                        <p class="text-lg font-black text-secondary"><%= (room.facultyMembers || []).length %> / <%= room.facultyCapacity || 10 %></p>
                                        <p class="text-[9px] uppercase font-bold text-on-surface-variant">Faculty</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } %>
            </div>
        </div>
    </main>

    <!-- Create Classroom Modal Backdrop -->
    <div id="createClassroomModal" class="fixed inset-0 overflow-y-auto z-50 hidden" role="dialog" aria-modal="true">
        <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
            <!-- Modal Background Overlay -->
            <div onclick="toggleCreateClassroomModal(false)" class="fixed inset-0 bg-inverse-surface/30 backdrop-blur-sm transition-opacity" aria-hidden="true"></div>
            
            <!-- Center align helper -->
            <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

            <!-- Modal Panel -->
            <div class="inline-block align-bottom bg-white rounded-2xl text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full border border-outline-variant/30">
                <div class="px-6 py-4 border-b border-outline-variant/20 flex justify-between items-center bg-surface-container-low/50">
                    <h3 class="text-lg font-bold text-on-surface flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">school</span> Create New Classroom
                    </h3>
                    <button onclick="toggleCreateClassroomModal(false)" class="rounded-md text-on-surface-variant hover:text-on-surface outline-none">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>

                <form class="p-6 space-y-4" id="classroomForm" onsubmit="submitClassroom(event)">
                    <div class="grid grid-cols-2 gap-4">
                        <div class="space-y-1">
                            <label class="font-label-md text-label-md text-on-surface-variant font-bold tracking-wide uppercase">Class Name *</label>
                            <input type="text" id="className" required class="w-full px-4 py-2.5 rounded-xl border border-outline-variant focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-body-md">
                        </div>
                        <div class="space-y-1">
                            <label class="font-label-md text-label-md text-on-surface-variant font-bold tracking-wide uppercase">Subject/Course *</label>
                            <input type="text" id="classSubject" required class="w-full px-4 py-2.5 rounded-xl border border-outline-variant focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-body-md">
                        </div>
                    </div>

                    <div class="grid grid-cols-3 gap-4">
                        <div class="space-y-1">
                            <label class="font-label-md text-label-md text-on-surface-variant font-bold tracking-wide uppercase">Academic Year *</label>
                            <select id="classYear" required class="w-full px-4 py-2.5 rounded-xl border border-outline-variant focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-body-md bg-white">
                                <option value="Year 1">Year 1</option>
                                <option value="Year 2">Year 2</option>
                                <option value="Year 3">Year 3</option>
                                <option value="Year 4">Year 4</option>
                            </select>
                        </div>
                        <div class="space-y-1">
                            <label class="font-label-md text-label-md text-on-surface-variant font-bold tracking-wide uppercase">Semester *</label>
                            <select id="classSemester" required class="w-full px-4 py-2.5 rounded-xl border border-outline-variant focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-body-md bg-white">
                                <option value="1st">1st</option>
                                <option value="2nd">2nd</option>
                                <option value="3rd">3rd</option>
                                <option value="4th">4th</option>
                                <option value="5th">5th</option>
                                <option value="6th">6th</option>
                                <option value="7th">7th</option>
                                <option value="8th">8th</option>
                            </select>
                        </div>
                        <div class="space-y-1">
                            <label class="font-label-md text-label-md text-on-surface-variant font-bold tracking-wide uppercase">Department *</label>
                            <select id="classDept" required class="w-full px-4 py-2.5 rounded-xl border border-outline-variant focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-body-md bg-white">
                                <option value="B.E. - Mechanical Engineering">B.E. - Mechanical Engineering</option>
                                <option value="B.E. - Electronics & Communication Engineering">B.E. - Electronics & Communication Engineering</option>
                                <option value="B.E. - Electrical & Electronics Engineering">B.E. - Electrical & Electronics Engineering</option>
                                <option value="B.E. - Computer Science & Engineering">B.E. - Computer Science & Engineering</option>
                                <option value="B.E. - Instrumentation & Controls Engineering">B.E. - Instrumentation & Controls Engineering</option>
                                <option value="B.Tech. - Information Technology">B.Tech. - Information Technology</option>
                                <option value="B.E. - Civil Engineering">B.E. - Civil Engineering</option>
                                <option value="B.E. - Electronics & Instrumentation Engineering">B.E. - Electronics & Instrumentation Engineering</option>
                                <option value="B.E. - Production Engineering">B.E. - Production Engineering</option>
                            </select>
                        </div>
                    </div>

                    <div class="space-y-1">
                        <label class="font-label-md text-label-md text-on-surface-variant font-bold tracking-wide uppercase">Description / Syllabus Overview</label>
                        <textarea id="classDesc" rows="3" class="w-full px-4 py-2.5 rounded-xl border border-outline-variant focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-body-md"></textarea>
                    </div>

                    <!-- Error Banner -->
                    <div id="modalErrorBanner" class="hidden text-error bg-error-container/30 border border-error/20 p-3 rounded-xl text-sm text-center font-medium"></div>

                    <!-- Modal Actions -->
                    <div class="flex justify-end items-center gap-3 pt-4 border-t border-outline-variant/20">
                        <button type="button" onclick="toggleCreateClassroomModal(false)" class="px-5 py-2.5 border border-outline-variant text-on-surface-variant font-semibold rounded-xl hover:bg-surface-container transition-all">Cancel</button>
                        <button type="submit" class="px-5 py-2.5 bg-primary text-white font-semibold rounded-xl hover:brightness-110 active:scale-95 transition-all shadow-md">Create Classroom</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Floating Global Toast Element -->
    <div id="toast" class="fixed bottom-6 right-6 px-4 py-2.5 bg-inverse-surface text-inverse-on-surface rounded-xl shadow-2xl text-sm font-semibold flex items-center gap-2 transform translate-y-20 opacity-0 transition-all duration-300 z-50 pointer-events-none">
        <span class="material-symbols-outlined text-sm text-green-400">check_circle</span>
        <span id="toastMsg">Code copied to clipboard!</span>
    </div>

    <!-- Delete Classroom Modal Backdrop -->
    <div id="deleteClassroomModal" class="fixed inset-0 overflow-y-auto z-50 hidden" role="dialog" aria-modal="true">
        <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
            <div onclick="toggleDeleteModal(false)" class="fixed inset-0 bg-inverse-surface/30 backdrop-blur-sm transition-opacity" aria-hidden="true"></div>
            <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

            <div class="inline-block align-bottom bg-white rounded-2xl text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-md sm:w-full border border-outline-variant/30">
                <div class="px-6 py-4 border-b border-outline-variant/20 flex justify-between items-center bg-error-container/10">
                    <h3 class="text-lg font-bold text-error flex items-center gap-2">
                        <span class="material-symbols-outlined">warning</span> Verify Classroom Deletion
                    </h3>
                    <button onclick="toggleDeleteModal(false)" class="rounded-md text-on-surface-variant hover:text-on-surface outline-none">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>

                <div class="p-6 space-y-4">
                    <p class="text-sm text-on-surface-variant leading-relaxed">
                        Are you sure you want to permanently delete this classroom? All associated student assignments and polls will be removed. This action cannot be undone.
                    </p>
                    <input type="hidden" id="deleteClassroomId">
                </div>

                <div class="flex justify-end items-center gap-3 p-6 border-t border-outline-variant/20">
                    <button onclick="toggleDeleteModal(false)" class="px-5 py-2.5 border border-outline-variant text-on-surface-variant font-semibold rounded-xl hover:bg-surface-container transition-all">Cancel</button>
                    <button onclick="executeClassroomDelete()" class="px-5 py-2.5 bg-error text-white font-semibold rounded-xl hover:brightness-110 active:scale-95 transition-all shadow-md">Confirm Delete</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        function toggleCreateClassroomModal(open) {
            const modal = document.getElementById('createClassroomModal');
            modal.classList.toggle('hidden', !open);
        }

        function showToast(message) {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toastMsg');
            toastMsg.innerText = message;
            
            toast.classList.remove('translate-y-20', 'opacity-0');
            
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }

        function copyToClipboard(code, btn) {
            navigator.clipboard.writeText(code).then(() => {
                showToast(`Classroom Code "${code}" copied!`);
            }).catch(() => {});
        }

        async function submitClassroom(e) {
            e.preventDefault();
            const name = document.getElementById('className').value.trim();
            const subject = document.getElementById('classSubject').value.trim();
            const year = document.getElementById('classYear').value;
            const semester = document.getElementById('classSemester').value;
            const department = document.getElementById('classDept').value.trim();
            const description = document.getElementById('classDesc').value.trim();

            const errorBanner = document.getElementById('modalErrorBanner');
            errorBanner.classList.add('hidden');

            try {
                const response = await fetch('/api/classrooms', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, subject, year, semester, department, description })
                });

                if (response.ok) {
                    window.location.reload();
                } else {
                    const data = await response.json();
                    errorBanner.innerText = data.error || 'Failed to create classroom.';
                    errorBanner.classList.remove('hidden');
                }
            } catch(err) {
                console.error(err);
                errorBanner.innerText = 'Failed to connect to the server.';
                errorBanner.classList.remove('hidden');
            }
        }
        function toggleDeleteModal(open) {
            const modal = document.getElementById('deleteClassroomModal');
            modal.classList.toggle('hidden', !open);
        }

        function deleteClassroom(id) {
            document.getElementById('deleteClassroomId').value = id;
            toggleDeleteModal(true);
        }

        async function executeClassroomDelete() {
            const id = document.getElementById('deleteClassroomId').value;
            toggleDeleteModal(false);
            try {
                const res = await fetch(`/api/classrooms/${id}`, { method: 'DELETE' });
                if (res.ok) {
                    window.location.reload();
                } else {
                    alert('Failed to delete classroom.');
                }
            } catch(e) {
                console.error(e);
            }
        }

        function toggleJoinModal(open) {
            document.getElementById('joinClassroomModal').classList.toggle('hidden', !open);
        }

        async function submitJoinClassroom() {
            const joinCode = document.getElementById('joinCodeInput').value.trim();
            if (!joinCode) return alert('Please enter a join code');
            const res = await fetch('/api/classrooms/join', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ joinCode })
            });
            const data = await res.json();
            if (res.ok) {
                alert(data.result?.status === 'PENDING_APPROVAL'
                    ? 'Membership request submitted! Waiting for Admin approval.'
                    : 'Classroom joined successfully!');
                window.location.reload();
            } else {
                alert(data.error || 'Failed to join classroom');
            }
        }
    </script>

    <!-- Modal: Join Classroom via Code -->
    <div id="joinClassroomModal" class="fixed inset-0 z-50 hidden bg-black/50 backdrop-blur-xs flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 space-y-5 shadow-2xl border border-outline-variant/30">
            <div class="flex justify-between items-center">
                <h3 class="text-lg font-bold text-on-surface">Join Classroom via Code</h3>
                <button onclick="toggleJoinModal(false)" class="text-on-surface-variant hover:text-on-surface">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div>
                <label class="block text-xs font-bold text-on-surface-variant uppercase mb-2">Classroom Join Code</label>
                <input type="text" id="joinCodeInput" placeholder="e.g. CS101-2026" class="w-full px-4 py-2.5 rounded-xl border border-outline-variant/50 focus:border-primary focus:outline-none text-sm font-mono uppercase">
                <p class="text-xs text-on-surface-variant mt-2">Faculty join requests require Admin approval before poll management privileges are granted.</p>
            </div>
            <div class="flex justify-end gap-3 pt-2">
                <button onclick="toggleJoinModal(false)" class="px-4 py-2 bg-surface-container text-on-surface rounded-xl font-bold text-sm">Cancel</button>
                <button onclick="submitJoinClassroom()" class="px-5 py-2 bg-primary text-white rounded-xl font-bold text-sm hover:brightness-110">Join Classroom</button>
            </div>
        </div>
    </div>
</body>
</html>
