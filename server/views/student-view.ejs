<%- include('partials/head') %>
<body class="bg-background text-on-background min-h-screen flex flex-col items-center">
    <!-- TopNavBar (Shared student layout style) -->
    <header class="fixed top-0 w-full z-50 flex justify-between items-center px-margin-desktop h-16 bg-surface/85 backdrop-blur-md border-b border-outline-variant/30 shadow-sm">
        <div class="flex items-center gap-4">
            <span class="font-headline-md text-headline-md font-bold text-primary flex items-center gap-2">
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">school</span> EduPoll
            </span>
            <div class="hidden md:flex gap-6 items-center ml-8 border-l border-outline-variant/20 pl-6">
                <span class="text-sm font-semibold text-on-surface">Student Portal</span>
            </div>
        </div>
        <div class="flex items-center gap-2">
            <a href="/student/mentees" class="flex items-center gap-1.5 px-3 py-1.5 border border-outline-variant hover:bg-tertiary-container/10 transition-all text-xs font-bold text-tertiary rounded-xl">
                <span class="material-symbols-outlined text-xs">groups</span> Mentorship Group
            </a>
            <a href="/student/history" class="flex items-center gap-1.5 px-3 py-1.5 border border-outline-variant hover:bg-primary-container/10 transition-all text-xs font-bold text-primary rounded-xl">
                <span class="material-symbols-outlined text-xs">history</span> Poll History
            </a>
            <a href="/messages" class="relative flex items-center gap-1.5 px-3 py-1.5 border border-outline-variant hover:bg-primary-container/10 transition-all text-xs font-bold text-primary rounded-xl">
                <span class="material-symbols-outlined text-xs">chat</span> Messages
                <% if (typeof unreadMessagesCount !== 'undefined' && unreadMessagesCount > 0) { %>
                <span class="unread-badge-dot absolute -top-1 -right-1 w-2.5 h-2.5 bg-error rounded-full ring-2 ring-white animate-pulse" title="Unread messages"></span>
                <% } %>
            </a>
            <!-- User Profile Menu (Logo + Name ONLY, no SEC ID) -->
            <div class="relative">
                <button onclick="toggleStudentUserMenu(event)" class="flex items-center gap-2.5 px-2.5 py-1.5 rounded-xl hover:bg-surface-container-low border border-transparent hover:border-outline-variant transition-all cursor-pointer">
                    <div class="w-8 h-8 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center font-bold text-xs shadow-sm">
                        <%= user ? user.name.charAt(0) : 'S' %>
                    </div>
                    <span class="text-sm font-semibold text-on-surface"><%= user ? user.name : 'Student' %></span>
                    <span class="material-symbols-outlined text-sm text-on-surface-variant">expand_more</span>
                </button>

                <!-- Dropdown Menu -->
                <div id="studentUserMenu" class="hidden absolute right-0 mt-2 w-52 bg-white border border-outline-variant/60 rounded-2xl shadow-xl py-2 z-50 animate-fade-in">
                    <div class="px-4 py-2 border-b border-outline-variant/30 mb-1">
                        <p class="text-xs font-bold text-on-surface"><%= user ? user.name : 'Student' %></p>
                        <p class="text-[11px] text-on-surface-variant truncate"><%= user ? user.email : '' %></p>
                    </div>
                    <button onclick="openStudentProfileModal()" class="w-full text-left flex items-center gap-2.5 px-4 py-2.5 text-xs font-bold text-primary hover:bg-primary/5 transition-all">
                        <span class="material-symbols-outlined text-base">person</span> My Profile
                    </button>
                    <a href="/api/auth/logout" class="flex items-center gap-2.5 px-4 py-2.5 text-xs font-bold text-error hover:bg-error/5 transition-all">
                        <span class="material-symbols-outlined text-base">logout</span> Logout
                    </a>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Canvas -->
    <main class="w-full max-w-2xl px-margin-mobile md:px-margin-desktop pt-24 pb-32 flex flex-col items-center">
        <!-- Live Status Bar -->
        <div class="w-full mb-8 flex flex-col items-center text-center">
            <div class="flex items-center gap-2 px-3 py-1 bg-error-container text-on-error-container rounded-full mb-4 animate-pulse">
                <span class="material-symbols-outlined text-xs" style="font-variation-settings: 'FILL' 1;">live_tv</span>
                <span class="font-label-md text-[10px] uppercase font-bold tracking-wider">Live Classroom Mode</span>
            </div>
            <h1 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface font-extrabold mb-1">Interactive Engagement Panel</h1>
            <p class="font-body-md text-body-md text-on-surface-variant max-w-md">Respond to live questions deployed by your instructor to log session attendance.</p>
        </div>

        <!-- Main Question Card Container -->
        <section class="w-full bg-white rounded-2xl border border-outline-variant/30 shadow-xl p-8 relative overflow-hidden hover-scale">
            <!-- Atmospheric Gradient -->
            <div class="absolute top-0 left-0 w-full h-1.5 bg-gradient-to-r from-primary via-primary-container to-primary"></div>

            <% if (activePoll) { %>
                <% if (hasResponded) { %>
                    <!-- Answer Verified Success State -->
                    <div class="text-center py-8 flex flex-col items-center gap-4 animate-fade-in">
                        <div class="w-16 h-16 rounded-full bg-green-100 flex items-center justify-center text-green-600 shadow-sm">
                            <span class="material-symbols-outlined text-[36px]">check_circle</span>
                        </div>
                        <div>
                            <h3 class="font-headline-md text-headline-md font-bold text-on-surface">Submission Verified!</h3>
                            <p class="text-on-surface-variant text-sm mt-1">Your choice has been recorded for today's session.</p>
                            
                            <div class="mt-4 p-4 bg-surface-container rounded-xl inline-block text-left border border-outline-variant/10">
                                <p class="text-xs text-on-surface-variant font-medium">Selected Answer:</p>
                                <p class="font-bold text-primary text-sm mt-0.5"><%= myResponse.selectedOption %></p>
                                <p class="text-[10px] text-outline font-mono mt-2">Recorded at: <%= new Date(myResponse.timestamp).toLocaleTimeString() %></p>
                            </div>
                        </div>
                        <p class="text-xs italic text-on-surface-variant/70 mt-6 animate-pulse flex items-center gap-1.5 justify-center">
                            <span class="material-symbols-outlined text-[12px] animate-spin">sync</span>
                            Waiting for the instructor to broadcast the next interaction...
                        </p>
                    </div>
                <% } else { %>
                    <!-- Active Question Forms -->
                    <form id="pollAnswerForm" onsubmit="submitAnswer(event, '<%= activePoll._id %>')" class="flex flex-col gap-6">
                        <div class="space-y-3">
                            <span class="px-2.5 py-0.5 bg-primary-container/15 text-primary text-[10px] font-bold uppercase tracking-wider rounded border border-primary/10">
                                <%= activePoll.type === 'activity' ? 'Activity Challenge' : 'Multiple Choice Poll' %>
                            </span>
                            
                            <h2 class="text-lg md:text-xl font-bold text-on-surface leading-snug">
                                <%= activePoll.question %>
                            </h2>
                            
                            <!-- Timer Badge -->
                            <div class="flex items-center gap-1.5 text-xs text-error font-bold font-mono bg-error-container/20 px-3 py-1 rounded-lg w-max" id="countdownContainer" data-ends="<%= activePoll.endsAt %>">
                                <span class="material-symbols-outlined text-sm">alarm</span>
                                <span id="countdownTimer">Loading...</span>
                            </div>
                        </div>

                        <!-- Styled Options List -->
                        <div class="flex flex-col gap-3">
                            <% activePoll.options.forEach((option, idx) => { %>
                                <div class="relative group">
                                    <input class="sr-only peer" id="option-<%= idx %>" name="pollOption" type="radio" value="<%= option %>" required onclick="highlightOption(this)">
                                    <label class="flex items-center gap-4 p-4 rounded-xl border border-outline-variant/40 hover:bg-surface-container-high transition-all duration-200 cursor-pointer peer-checked:border-primary peer-checked:bg-primary-fixed select-none active:scale-98" for="option-<%= idx %>" id="label-<%= idx %>">
                                        <div class="w-5 h-5 rounded-full border-2 border-outline-variant flex items-center justify-center shrink-0 transition-all peer-checked:border-primary" id="circle-<%= idx %>">
                                            <div class="w-2.5 h-2.5 rounded-full bg-primary scale-0 transition-transform duration-200" id="inner-circle-<%= idx %>"></div>
                                        </div>
                                        <span class="text-sm font-semibold text-on-surface-variant" id="text-<%= idx %>"><%= option %></span>
                                    </label>
                                </div>
                            <% }) %>
                        </div>

                        <div id="errorBanner" class="hidden text-error bg-error-container/30 border border-error/20 p-3 rounded-xl text-sm text-center font-medium"></div>

                        <!-- Submit Action Button -->
                        <button type="submit" class="w-full bg-primary text-white font-bold py-3.5 rounded-xl shadow-md hover:shadow-lg active:scale-[0.98] transition-all flex items-center justify-center gap-2">
                            <span class="material-symbols-outlined text-sm">send</span> Submit Answer
                        </button>
                    </form>
                <% } %>
            <% } else { %>
                <!-- Empty State -->
                <div class="text-center py-12 flex flex-col items-center gap-4">
                    <span class="material-symbols-outlined text-[48px] text-on-surface-variant/30">sensors_off</span>
                    <div>
                        <h3 class="font-headline-md text-headline-md font-bold text-on-surface">No Active Classroom Polls</h3>
                        <p class="text-on-surface-variant text-sm mt-1">There are no active questions or challenges targeted to your classroom at this time.</p>
                    </div>
                    <button onclick="window.location.reload();" class="mt-4 px-6 py-2.5 bg-primary text-white font-bold rounded-xl shadow-md hover:brightness-110 active:scale-95 transition-all text-sm flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-sm">sync</span> Sync Status
                    </button>
                </div>
            <% } %>
        </section>

        <!-- Mobile Navigation Bottom Panel -->
        <nav class="md:hidden fixed bottom-0 w-full z-50 flex justify-around items-center px-4 py-2 pb-safe bg-white/80 backdrop-blur-lg border-t border-outline-variant/30 shadow-2xl">
            <button onclick="window.location.reload();" class="flex flex-col items-center justify-center text-primary rounded-full px-4 py-1">
                <span class="material-symbols-outlined">live_tv</span>
                <span class="font-label-md text-[10px]">Live</span>
            </button>
            <button onclick="alert('Student poll activity log is archived automatically under local sessions history.')" class="flex flex-col items-center justify-center text-on-surface-variant hover:text-on-surface rounded-full px-4 py-1">
                <span class="material-symbols-outlined">history</span>
                <span class="font-label-md text-[10px]">History</span>
            </button>
            <button onclick="alert('Student profile details: <%= user ? user.name : 'Unknown' %> in <%= user && user.classroom ? user.classroom.name : 'Unassigned Class' %>')" class="flex flex-col items-center justify-center text-on-surface-variant hover:text-on-surface rounded-full px-4 py-1">
                <span class="material-symbols-outlined">person</span>
                <span class="font-label-md text-[10px]">Profile</span>
            </button>
        </nav>
    </main>

    <script>
        function highlightOption(input) {
            // Remove check indicators from all custom radio buttons
            const radios = document.querySelectorAll('input[name="pollOption"]');
            radios.forEach((r, idx) => {
                const label = document.getElementById(`label-${idx}`);
                const circle = document.getElementById(`circle-${idx}`);
                const innerCircle = document.getElementById(`inner-circle-${idx}`);
                const text = document.getElementById(`text-${idx}`);

                if (r.checked) {
                    label.className = "flex items-center gap-4 p-4 rounded-xl border border-primary bg-primary-fixed/30 cursor-pointer transition-all duration-200 select-none";
                    circle.className = "w-5 h-5 rounded-full border-2 border-primary flex items-center justify-center shrink-0 transition-all";
                    innerCircle.className = "w-2.5 h-2.5 rounded-full bg-primary scale-100 transition-transform duration-200";
                    text.className = "text-sm font-bold text-primary";
                } else {
                    label.className = "flex items-center gap-4 p-4 rounded-xl border border-outline-variant/40 hover:bg-surface-container-high transition-all duration-200 cursor-pointer select-none";
                    circle.className = "w-5 h-5 rounded-full border-2 border-outline-variant flex items-center justify-center shrink-0 transition-all";
                    innerCircle.className = "w-2.5 h-2.5 rounded-full bg-primary scale-0 transition-transform duration-200";
                    text.className = "text-sm font-semibold text-on-surface-variant";
                }
            });
        }

        // Countdown Timer Script
        const countdownContainer = document.getElementById('countdownContainer');
        if (countdownContainer) {
            const endsAt = new Date(countdownContainer.getAttribute('data-ends')).getTime();
            const timerLabel = document.getElementById('countdownTimer');

            function updateTimer() {
                const now = new Date().getTime();
                const diff = endsAt - now;

                if (diff <= 0) {
                    timerLabel.innerText = "Time Expired";
                    document.getElementById('countdownContainer').className = "flex items-center gap-1.5 text-xs text-error font-bold font-mono bg-error-container/30 px-3 py-1 rounded-lg w-max";
                    // Disable submission
                    const form = document.getElementById('pollAnswerForm');
                    if (form) {
                        const submitBtn = form.querySelector('button[type="submit"]');
                        submitBtn.disabled = true;
                        submitBtn.innerText = "Poll Expired";
                        submitBtn.className = "w-full bg-outline text-white font-bold py-3.5 rounded-xl cursor-not-allowed flex items-center justify-center gap-2";
                    }
                    clearInterval(timerInterval);
                    return;
                }

                const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((diff % (1000 * 60)) / 1000);

                const minStr = String(minutes).padStart(2, '0');
                const secStr = String(seconds).padStart(2, '0');

                timerLabel.innerText = `${minStr}:${secStr} remaining`;
            }

            updateTimer();
            const timerInterval = setInterval(updateTimer, 1000);
        }

        async function submitAnswer(e, pollId) {
            e.preventDefault();
            const selected = document.querySelector('input[name="pollOption"]:checked');
            if (!selected) {
                alert('Please select an option first.');
                return;
            }

            const option = selected.value;
            const errorBanner = document.getElementById('errorBanner');
            errorBanner.classList.add('hidden');

            try {
                const response = await fetch(`/api/polls/${pollId}/submit`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ selectedOption: option })
                });

                if (response.ok) {
                    window.location.reload();
                } else {
                    const data = await response.json();
                    errorBanner.innerText = data.error || 'Failed to submit response';
                    errorBanner.classList.remove('hidden');
                }
            } catch(err) {
                console.error(err);
                errorBanner.innerText = 'Failed to connect to the server';
                errorBanner.classList.remove('hidden');
            }
        }

        function toggleStudentUserMenu(event) {
            event.stopPropagation();
            const menu = document.getElementById('studentUserMenu');
            if (menu) menu.classList.toggle('hidden');
        }

        function openStudentProfileModal() {
            const menu = document.getElementById('studentUserMenu');
            if (menu) menu.classList.add('hidden');
            document.getElementById('studentProfileModal').classList.remove('hidden');
        }

        function closeStudentProfileModal() {
            document.getElementById('studentProfileModal').classList.add('hidden');
        }

        document.addEventListener('click', () => {
            const menu = document.getElementById('studentUserMenu');
            if (menu && !menu.classList.contains('hidden')) menu.classList.add('hidden');
        });
    </script>

    <!-- Student Profile Modal Overlay -->
    <div id="studentProfileModal" class="hidden fixed inset-0 z-50 bg-on-surface/50 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white border border-outline-variant rounded-3xl shadow-2xl max-w-lg w-full overflow-hidden animate-fade-in">
            <!-- Modal Header -->
            <div class="px-6 py-4 border-b border-outline-variant/40 flex items-center justify-between bg-surface-container-low/50">
                <div class="flex items-center gap-2.5">
                    <span class="material-symbols-outlined text-primary text-2xl">badge</span>
                    <h3 class="font-extrabold text-on-surface text-base">My Student Profile</h3>
                </div>
                <button onclick="closeStudentProfileModal()" class="p-1 hover:bg-surface-container rounded-full text-on-surface-variant transition-all">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <!-- Modal Body -->
            <div class="p-6 space-y-6 max-h-[80vh] overflow-y-auto">
                <!-- User Avatar & Identity -->
                <div class="flex items-center gap-4 p-4 rounded-2xl bg-surface-container-low/60 border border-outline-variant/30">
                    <div class="w-14 h-14 rounded-full bg-primary text-white flex items-center justify-center font-extrabold text-2xl shadow">
                        <%= user ? user.name.charAt(0) : 'S' %>
                    </div>
                    <div>
                        <h4 class="font-extrabold text-on-surface text-lg"><%= user ? user.name : 'Student' %></h4>
                        <span class="inline-block px-2.5 py-0.5 bg-primary/10 text-primary font-code font-bold text-xs rounded-full mt-1">
                            <%= user ? user.secId : '' %>
                        </span>
                    </div>
                </div>

                <!-- Academic Info Grid -->
                <div>
                    <h5 class="text-xs font-bold uppercase tracking-wider text-on-surface-variant mb-3">Academic Enrollment Details</h5>
                    <div class="grid grid-cols-2 gap-3">
                        <div class="p-3.5 rounded-xl bg-surface border border-outline-variant/30">
                            <span class="text-[10px] font-bold text-on-surface-variant uppercase">Department</span>
                            <p class="text-xs font-extrabold text-on-surface mt-0.5"><%= user ? (user.department || 'General') : 'N/A' %></p>
                        </div>
                        <div class="p-3.5 rounded-xl bg-surface border border-outline-variant/30">
                            <span class="text-[10px] font-bold text-on-surface-variant uppercase">Email Address</span>
                            <p class="text-xs font-bold text-on-surface mt-0.5 truncate"><%= user ? (user.email || 'N/A') : 'N/A' %></p>
                        </div>
                        <div class="p-3.5 rounded-xl bg-surface border border-outline-variant/30">
                            <span class="text-[10px] font-bold text-on-surface-variant uppercase">Year & Section</span>
                            <p class="text-xs font-extrabold text-on-surface mt-0.5"><%= user ? (user.year || 'N/A') : 'N/A' %> - Sec <%= user ? (user.section || 'N/A') : 'N/A' %></p>
                        </div>
                        <div class="p-3.5 rounded-xl bg-surface border border-outline-variant/30">
                            <span class="text-[10px] font-bold text-on-surface-variant uppercase">Classroom Batch</span>
                            <p class="text-xs font-extrabold text-on-surface mt-0.5">
                                <%= (user && user.classroom && user.classroom.name) ? user.classroom.name : (user && user.classroom ? user.classroom.code || 'Assigned' : 'Not Assigned') %>
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Mentor Section -->
                <div>
                    <h5 class="text-xs font-bold uppercase tracking-wider text-on-surface-variant mb-3">Assigned Faculty Mentor</h5>
                    <% if (typeof mentor !== 'undefined' && mentor) { %>
                        <div class="p-4 rounded-2xl bg-gradient-to-r from-tertiary-container/40 to-white border border-tertiary/20 flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-tertiary/10 text-tertiary flex items-center justify-center font-extrabold text-base">
                                    <%= mentor.name ? mentor.name.charAt(0) : 'M' %>
                                </div>
                                <div>
                                    <p class="text-sm font-extrabold text-on-surface"><%= mentor.name %></p>
                                    <p class="text-xs text-on-surface-variant"><%= mentor.department || 'Faculty Mentor' %></p>
                                </div>
                            </div>
                            <a href="/messages" class="px-3 py-1.5 bg-tertiary text-white font-bold text-xs rounded-xl shadow hover:brightness-110 flex items-center gap-1">
                                <span class="material-symbols-outlined text-xs">chat</span> Chat
                            </a>
                        </div>
                    <% } else { %>
                        <div class="p-4 rounded-2xl bg-surface border border-dashed border-outline-variant text-center">
                            <p class="text-xs font-bold text-on-surface-variant">No Mentor Currently Assigned</p>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="px-6 py-4 border-t border-outline-variant/40 bg-surface-container-low/50 flex justify-between items-center">
                <a href="/student/profile" class="text-xs font-bold text-primary hover:underline flex items-center gap-1">
                    <span>Full Profile Page</span>
                    <span class="material-symbols-outlined text-sm">arrow_forward</span>
                </a>
                <button onclick="closeStudentProfileModal()" class="px-5 py-2 bg-on-surface text-white text-xs font-bold rounded-xl hover:brightness-110 transition-all">
                    Close
                </button>
            </div>
        </div>
    </div>
</body>
</html>
