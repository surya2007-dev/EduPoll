<%- include('partials/head') %>
<body class="bg-background min-h-screen flex items-center justify-center p-4">
    <!-- Login Card Container -->
    <section class="w-full max-w-md bg-white border border-outline-variant/30 rounded-2xl shadow-xl overflow-hidden p-8 hover-scale">
        <!-- Logo Header -->
        <div class="flex flex-col items-center mb-6 text-center">
            <div class="w-12 h-12 rounded-xl bg-primary flex items-center justify-center text-white mb-2 shadow-md">
                <span class="material-symbols-outlined text-2xl" style="font-variation-settings: 'FILL' 1;">school</span>
            </div>
            <h1 class="font-headline-md text-headline-md font-bold text-primary">EduPoll</h1>
            <p class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider mt-1">Unified Authentication Gateway</p>
        </div>

        <!-- Role Toggle Tabs -->
        <div class="flex border-b border-outline-variant/30 mb-6">
            <button id="tab-faculty" onclick="switchRole('faculty')" class="flex-1 pb-3 text-center text-sm font-semibold border-b-2 border-primary text-primary transition-all duration-200">
                Faculty & Admin
            </button>
            <button id="tab-student" onclick="switchRole('student')" class="flex-1 pb-3 text-center text-sm font-semibold border-b-2 border-transparent text-on-surface-variant hover:text-on-surface transition-all duration-200">
                Student Access
            </button>
        </div>

        <h2 class="text-xl font-bold text-on-surface mb-1 text-center" id="gateTitle">Sign in as Instructor</h2>
        <p class="text-xs text-on-surface-variant text-center mb-6" id="gateSub">Select your workspace to continue</p>

        <!-- Form API -->
        <form class="space-y-4" id="loginForm" onsubmit="handleLoginSubmit(event)">
            <!-- Role state field -->
            <input type="hidden" id="loginRole" value="faculty">

            <div class="space-y-1">
                <label id="inputLabel" class="font-label-md text-label-md text-on-surface-variant font-bold tracking-wide uppercase">User ID / Faculty ID</label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant/50 text-sm">person</span>
                    <input type="text" id="secId" required placeholder="" class="w-full pl-10 pr-4 py-3 rounded-xl border border-outline-variant focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-body-md placeholder:text-outline-variant">
                </div>
            </div>

            <div class="space-y-1 relative">
                <div class="flex justify-between items-center">
                    <label class="font-label-md text-label-md text-on-surface-variant font-bold tracking-wide uppercase">Password</label>
                    <a href="#" onclick="alert('Demo reset instructions: passwords can be modified in seed.js or db.js.')" class="text-xs text-primary font-bold hover:underline">Forgot Password?</a>
                </div>
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant/50 text-sm">lock</span>
                    <input type="password" id="password" required placeholder="••••••••" class="w-full pl-10 pr-10 py-3 rounded-xl border border-outline-variant focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-body-md placeholder:text-outline-variant">
                    <button type="button" onclick="togglePasswordVisibility()" class="absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant/50 hover:text-on-surface transition-all">
                        <span class="material-symbols-outlined text-sm" id="visibilityIcon">visibility</span>
                    </button>
                </div>
            </div>

            <!-- Error Banner -->
            <div id="errorBanner" class="hidden text-error bg-error-container/30 border border-error/20 p-3 rounded-xl text-sm text-center font-medium"></div>

            <div class="flex items-center gap-2 py-1">
                <input type="checkbox" id="remember" class="w-4 h-4 rounded border-outline-variant text-primary focus:ring-primary">
                <label for="remember" class="text-xs text-on-surface-variant cursor-pointer font-medium">Remember this device</label>
            </div>

            <button type="submit" class="w-full py-3 bg-primary text-white rounded-xl font-bold hover:shadow-lg active:scale-95 transition-all shadow-md mt-2 flex items-center justify-center gap-2">
                <span class="material-symbols-outlined text-sm">login</span> Sign In
            </button>
        </form>
    </section>

    <!-- Visual backgrounds -->
    <div class="fixed top-0 right-0 w-[400px] h-[400px] bg-primary/5 blur-[120px] rounded-full -z-10 pointer-events-none animate-pulse"></div>
    <div class="fixed bottom-0 left-0 w-[400px] h-[400px] bg-tertiary/5 blur-[100px] rounded-full -z-10 pointer-events-none animate-pulse"></div>

    <script>
        function switchRole(role) {
            const tabFaculty = document.getElementById('tab-faculty');
            const tabStudent = document.getElementById('tab-student');
            const roleField = document.getElementById('loginRole');
            const inputLabel = document.getElementById('inputLabel');
            const secId = document.getElementById('secId');
            const gateTitle = document.getElementById('gateTitle');

            roleField.value = role;

            if (role === 'faculty') {
                tabFaculty.className = "flex-1 pb-3 text-center text-sm font-semibold border-b-2 border-primary text-primary transition-all duration-200";
                tabStudent.className = "flex-1 pb-3 text-center text-sm font-semibold border-b-2 border-transparent text-on-surface-variant hover:text-on-surface transition-all duration-200";
                inputLabel.innerText = "User ID / Faculty ID";
                secId.placeholder = "";
                gateTitle.innerText = "Sign in as Instructor / Admin";
            } else {
                tabStudent.className = "flex-1 pb-3 text-center text-sm font-semibold border-b-2 border-primary text-primary transition-all duration-200";
                tabFaculty.className = "flex-1 pb-3 text-center text-sm font-semibold border-b-2 border-transparent text-on-surface-variant hover:text-on-surface transition-all duration-200";
                inputLabel.innerText = "Student SEC ID";
                secId.placeholder = "";
                gateTitle.innerText = "Sign in as Student";
            }
        }

        function togglePasswordVisibility() {
            const passField = document.getElementById('password');
            const icon = document.getElementById('visibilityIcon');
            if (passField.type === 'password') {
                passField.type = 'text';
                icon.innerText = 'visibility_off';
            } else {
                passField.type = 'password';
                icon.innerText = 'visibility';
            }
        }

        async function handleLoginSubmit(e) {
            e.preventDefault();
            const secId = document.getElementById('secId').value.trim();
            const password = document.getElementById('password').value;
            const role = document.getElementById('loginRole').value;
            
            const errorBanner = document.getElementById('errorBanner');
            errorBanner.classList.add('hidden');

            try {
                const response = await fetch('/api/auth/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ secId, password, role })
                });

                const data = await response.json();
                if (response.ok && data.success) {
                    if (data.role === 'admin') {
                        window.location.href = '/admin/dashboard';
                    } else if (data.role === 'faculty') {
                        window.location.href = '/faculty/dashboard';
                    } else {
                        window.location.href = '/student/polls';
                    }
                } else {
                    errorBanner.innerText = data.error || 'Authentication failed.';
                    errorBanner.classList.remove('hidden');
                }
            } catch (err) {
                console.error(err);
                errorBanner.innerText = 'Failed to connect to the server.';
                errorBanner.classList.remove('hidden');
            }
        }
    </script>
</body>
</html>
