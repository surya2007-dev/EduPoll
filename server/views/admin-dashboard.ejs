<%- include('partials/head') %>
<body class="bg-background min-h-screen">
    <!-- Navigation Shared Partials -->
    <%- include('partials/sidebar') %>
    <%- include('partials/header') %>

    <!-- Main Content Canvas -->
    <main class="pt-24 pb-20 px-margin-mobile md:px-margin-desktop lg:pl-[280px]">
        <div class="max-w-[1440px] mx-auto space-y-6">
            <!-- Header section -->
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white p-6 rounded-2xl border border-outline-variant/30 shadow-sm">
                <div>
                    <h1 class="text-2xl font-bold text-on-surface">Administrative Overview</h1>
                    <p class="text-on-surface-variant text-sm mt-1">Review live portal enrollment statistics and metrics details.</p>
                </div>
            </div>

            <!-- Clickable Stats Grid -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Faculty Count Card (Clickable) -->
                <a href="/admin/faculties" class="bg-white p-6 rounded-2xl border border-outline-variant/30 shadow-sm hover:border-primary hover:shadow-md active:scale-98 transition-all flex items-center justify-between cursor-pointer group">
                    <div class="space-y-1">
                        <p class="text-xs uppercase font-bold text-on-surface-variant group-hover:text-primary transition-colors">Active Faculty</p>
                        <h3 class="text-3xl font-black text-on-surface"><%= stats.totalFaculty %></h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center font-bold group-hover:bg-primary group-hover:text-white transition-all">
                        <span class="material-symbols-outlined text-2xl">co_present</span>
                    </div>
                </a>

                <!-- Classrooms Count Card (Clickable) -->
                <a href="/admin/classrooms" class="bg-white p-6 rounded-2xl border border-outline-variant/30 shadow-sm hover:border-primary hover:shadow-md active:scale-98 transition-all flex items-center justify-between cursor-pointer group">
                    <div class="space-y-1">
                        <p class="text-xs uppercase font-bold text-on-surface-variant group-hover:text-primary transition-colors">Active Classrooms</p>
                        <h3 class="text-3xl font-black text-on-surface"><%= stats.totalClassrooms %></h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center font-bold group-hover:bg-primary group-hover:text-white transition-all">
                        <span class="material-symbols-outlined text-2xl">school</span>
                    </div>
                </a>

                <!-- Students Count Card (Clickable) -->
                <a href="/admin/students" class="bg-white p-6 rounded-2xl border border-outline-variant/30 shadow-sm hover:border-primary hover:shadow-md active:scale-98 transition-all flex items-center justify-between cursor-pointer group">
                    <div class="space-y-1">
                        <p class="text-xs uppercase font-bold text-on-surface-variant group-hover:text-primary transition-colors">Total Students</p>
                        <h3 class="text-3xl font-black text-on-surface"><%= stats.totalStudents %></h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center font-bold group-hover:bg-primary group-hover:text-white transition-all">
                        <span class="material-symbols-outlined text-2xl">people</span>
                    </div>
                </a>
            </div>
        </div>
    </main>
</body>
</html>
