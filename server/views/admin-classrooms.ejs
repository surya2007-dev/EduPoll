<%- include('partials/head') %>
<body class="bg-background min-h-screen">
    <!-- Navigation Shared Partials -->
    <%- include('partials/sidebar') %>
    <%- include('partials/header') %>

    <!-- Main Content Canvas -->
    <main class="pt-24 pb-20 px-margin-mobile md:px-margin-desktop lg:pl-[280px]">
        <div class="max-w-[1440px] mx-auto space-y-6">
            <!-- Header section -->
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white p-6 rounded-2xl border border-outline-variant/30 shadow-sm">
                <div>
                    <h1 class="text-2xl font-bold text-on-surface">Active Classroom Overview</h1>
                    <p class="text-on-surface-variant text-sm mt-1">Review active classroom distributions and live student enrollments.</p>
                </div>
            </div>

            <!-- Back to dashboard link -->
            <div>
                <a href="/admin/dashboard" class="text-xs font-bold text-primary flex items-center gap-1 hover:underline">
                    <span class="material-symbols-outlined text-xs">arrow_back</span> Back to Administrative Overview
                </a>
            </div>

            <!-- Table -->
            <div class="bg-white rounded-2xl border border-outline-variant/30 shadow-sm overflow-hidden animate-fade-in">
                <div class="px-6 py-4 border-b border-outline-variant/20 flex justify-between items-center">
                    <h4 class="font-bold text-on-surface font-headline-sm">Classroom Registry</h4>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse" id="classroomTable">
                        <thead>
                            <tr class="bg-surface-container-high/30">
                                <th class="px-6 py-4 font-label-md text-on-surface-variant border-b border-outline-variant/20">Classroom Code</th>
                                <th class="px-6 py-4 font-label-md text-on-surface-variant border-b border-outline-variant/20">Name / Subject</th>
                                <th class="px-6 py-4 font-label-md text-on-surface-variant border-b border-outline-variant/20">Department</th>
                                <th class="px-6 py-4 font-label-md text-on-surface-variant border-b border-outline-variant/20">Year / Semester</th>
                                <th class="px-6 py-4 font-label-md text-on-surface-variant border-b border-outline-variant/20">Enrolled Students</th>
                                <th class="px-6 py-4 font-label-md text-on-surface-variant border-b border-outline-variant/20">Assigned Faculty</th>
                                <th class="px-6 py-4 font-label-md text-on-surface-variant border-b border-outline-variant/20">Live Status</th>
                                <th class="px-6 py-4 font-label-md text-on-surface-variant border-b border-outline-variant/20 text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-outline-variant/10">
                            <% if (classrooms.length === 0) { %>
                                <tr>
                                    <td colspan="7" class="px-6 py-12 text-center text-on-surface-variant italic bg-white">No active classrooms found.</td>
                                </tr>
                            <% } else { %>
                                <% classrooms.forEach(room => { %>
                                    <tr class="hover:bg-primary-container/5 transition-colors">
                                        <td class="px-6 py-4 font-code text-xs text-on-surface font-bold">
                                            <span class="px-2.5 py-1 bg-surface-container border border-outline-variant/30 rounded"><%= room.code %></span>
                                        </td>
                                        <td class="px-6 py-4">
                                            <p class="font-semibold text-on-surface text-sm"><%= room.name %></p>
                                            <p class="text-xs text-on-surface-variant truncate"><%= room.subject %></p>
                                        </td>
                                        <td class="px-6 py-4 text-sm text-on-surface-variant"><%= room.department %></td>
                                        <td class="px-6 py-4 text-xs font-semibold text-primary"><%= room.year %> • Sem <%= room.semester %></td>
                                        <td class="px-6 py-4 text-sm text-on-surface font-bold">
                                            <%= (room.students || []).length %> / <%= room.studentCapacity || 63 %>
                                        </td>
                                        <td class="px-6 py-4 text-sm text-on-surface font-bold">
                                            <%= (room.facultyMembers || []).length %> / <%= room.facultyCapacity || 10 %>
                                        </td>
                                        <td class="px-6 py-4 text-sm">
                                            <% if (room.hasLivePoll) { %>
                                                <span class="flex items-center gap-1.5 px-2 py-0.5 w-fit bg-error-container text-on-error-container rounded-full animate-pulse text-[10px] font-bold uppercase tracking-wider">
                                                    <span class="material-symbols-outlined text-[10px]" style="font-variation-settings: 'FILL' 1;">live_tv</span> Active Poll
                                                </span>
                                            <% } else { %>
                                                <span class="text-xs text-on-surface-variant/60">Idle</span>
                                            <% } %>
                                        </td>
                                        <td class="px-6 py-4 text-right">
                                            <a href="/admin/classrooms/<%= room._id %>" class="px-3.5 py-1.5 bg-primary text-white rounded-lg text-xs font-bold shadow-2xs hover:brightness-110 transition-all">
                                                Manage
                                            </a>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
</body>
</html>
