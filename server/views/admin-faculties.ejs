<%- include('partials/head') %>
<body class="bg-background min-h-screen">
    <!-- Navigation Shared Partials -->
    <%- include('partials/sidebar') %>
    <%- include('partials/header') %>

    <!-- Main Content Canvas -->
    <main class="pt-24 pb-20 px-margin-mobile md:px-margin-desktop lg:pl-[280px]">
        <div class="max-w-[1440px] mx-auto space-y-6">
            <!-- Header section -->
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white p-6 rounded-2xl border border-outline-variant/30 shadow-sm">
                <div>
                    <h1 class="text-2xl font-bold text-on-surface">Faculty Member Registry</h1>
                    <p class="text-on-surface-variant text-sm mt-1">Manage academic staff accounts and registration authorizations.</p>
                </div>
                <button onclick="toggleRegisterModal(true)" class="px-5 py-2.5 bg-primary text-white font-bold rounded-xl shadow-md hover:brightness-110 active:scale-95 transition-all text-sm flex items-center gap-2">
                    <span class="material-symbols-outlined text-sm">person_add</span> Register Faculty Member
                </button>
            </div>

            <!-- Back to dashboard link -->
            <div>
                <a href="/admin/dashboard" class="text-xs font-bold text-primary flex items-center gap-1 hover:underline">
                    <span class="material-symbols-outlined text-xs">arrow_back</span> Back to Administrative Overview
                </a>
            </div>

            <!-- Faculty Roster Table -->
            <div class="bg-white rounded-2xl border border-outline-variant/30 shadow-sm overflow-hidden animate-fade-in">
                <div class="px-6 py-4 border-b border-outline-variant/20 flex justify-between items-center">
                    <h4 class="font-bold text-on-surface font-headline-sm">Registered Staff Profiles</h4>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse" id="facultyTable">
                        <thead>
                            <tr class="bg-surface-container-high/30">
                                <th class="px-6 py-4 font-label-md text-on-surface-variant border-b border-outline-variant/20">Name</th>
                                <th class="px-6 py-4 font-label-md text-on-surface-variant border-b border-outline-variant/20">Faculty ID</th>
                                <th class="px-6 py-4 font-label-md text-on-surface-variant border-b border-outline-variant/20">Email</th>
                                <th class="px-6 py-4 font-label-md text-on-surface-variant border-b border-outline-variant/20">Gender</th>
                                <th class="px-6 py-4 font-label-md text-on-surface-variant border-b border-outline-variant/20">Department</th>
                                <th class="px-6 py-4 font-label-md text-on-surface-variant border-b border-outline-variant/20 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-outline-variant/10">
                            <% if (faculties.length === 0) { %>
                                <tr>
                                    <td colspan="6" class="px-6 py-12 text-center text-on-surface-variant italic bg-white">No registered faculty members found.</td>
                                </tr>
                            <% } else { %>
                                <% faculties.forEach(fac => { %>
                                    <tr class="hover:bg-primary-container/5 transition-colors">
                                        <td class="px-6 py-4">
                                            <div class="flex items-center gap-3">
                                                <div class="w-9 h-9 rounded-full bg-surface-container flex items-center justify-center font-bold text-primary border border-outline-variant/20">
                                                    <%= fac.name.charAt(0) %>
                                                </div>
                                                <p class="font-semibold text-on-surface text-sm"><%= fac.name %></p>
                                            </div>
                                        </td>
                                        <td class="px-6 py-4 font-code text-xs text-on-surface-variant font-bold"><%= fac.secId %></td>
                                        <td class="px-6 py-4 text-sm text-on-surface-variant"><%= fac.email %></td>
                                        <td class="px-6 py-4 text-sm text-on-surface-variant font-semibold"><%= fac.gender || 'Male' %></td>
                                        <td class="px-6 py-4 text-xs font-semibold text-primary"><%= fac.department %></td>
                                        <td class="px-6 py-4 text-right">
                                            <button onclick="confirmDeleteFaculty('<%= fac._id %>', '<%= fac.name %>')" class="p-2 text-error hover:bg-error-container/20 rounded-xl transition-all inline-flex items-center justify-center">
                                                <span class="material-symbols-outlined text-sm">delete</span>
                                            </button>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>

    <!-- Register Faculty Modal Backdrop -->
    <div id="registerModal" class="fixed inset-0 overflow-y-auto z-50 hidden" role="dialog" aria-modal="true">
        <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
            <div onclick="toggleRegisterModal(false)" class="fixed inset-0 bg-inverse-surface/30 backdrop-blur-sm transition-opacity" aria-hidden="true"></div>
            <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

            <div class="inline-block align-bottom bg-white rounded-2xl text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full border border-outline-variant/30">
                <div class="px-6 py-4 border-b border-outline-variant/20 flex justify-between items-center bg-surface-container-low/50">
                    <h3 class="text-lg font-bold text-on-surface flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">person_add</span> Register Faculty Member
                    </h3>
                    <button onclick="toggleRegisterModal(false)" class="rounded-md text-on-surface-variant hover:text-on-surface outline-none">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>

                <form class="p-6 space-y-4" id="facultyForm" onsubmit="submitFaculty(event)">
                    <div class="grid grid-cols-2 gap-4">
                        <div class="space-y-1">
                            <label class="font-label-md text-label-md text-on-surface-variant font-bold tracking-wide uppercase">Full Name *</label>
                            <input type="text" id="facName" required class="w-full px-4 py-2.5 rounded-xl border border-outline-variant focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-body-md">
                        </div>
                        <div class="space-y-1">
                            <label class="font-label-md text-label-md text-on-surface-variant font-bold tracking-wide uppercase">Faculty ID / User ID *</label>
                            <input type="text" id="facSecId" required class="w-full px-4 py-2.5 rounded-xl border border-outline-variant focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-body-md">
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div class="space-y-1">
                            <label class="font-label-md text-label-md text-on-surface-variant font-bold tracking-wide uppercase">Department *</label>
                            <select id="facDept" required class="w-full px-4 py-2.5 rounded-xl border border-outline-variant focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-body-md bg-white">
                                <option value="B.E. - Mechanical Engineering">B.E. - Mechanical Engineering</option>
                                <option value="B.E. - Electronics & Communication Engineering">B.E. - Electronics & Communication Engineering</option>
                                <option value="B.E. - Electrical & Electronics Engineering">B.E. - Electrical & Electronics Engineering</option>
                                <option value="B.E. - Computer Science & Engineering">B.E. - Computer Science & Engineering</option>
                                <option value="B.E. - Instrumentation & Controls Engineering">B.E. - Instrumentation & Controls Engineering</option>
                                <option value="B.Tech. - Information Technology">B.Tech. - Information Technology</option>
                                <option value="B.E. - Civil Engineering">B.E. - Civil Engineering</option>
                                <option value="B.E. - Electronics & Instrumentation Engineering">B.E. - Electronics & Instrumentation Engineering</option>
                                <option value="B.E. - Production Engineering">B.E. - Production Engineering</option>
                            </select>
                        </div>
                        <div class="space-y-1">
                            <label class="font-label-md text-label-md text-on-surface-variant font-bold tracking-wide uppercase">Email Address *</label>
                            <input type="email" id="facEmail" required class="w-full px-4 py-2.5 rounded-xl border border-outline-variant focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-body-md">
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div class="space-y-1 relative">
                            <label class="font-label-md text-label-md text-on-surface-variant font-bold tracking-wide uppercase">Login Password *</label>
                            <div class="relative">
                                <input type="password" id="facPass" required class="w-full px-4 py-2.5 rounded-xl border border-outline-variant focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-body-md">
                                <button type="button" onclick="togglePass()" class="absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant/50 hover:text-on-surface transition-all">
                                    <span class="material-symbols-outlined text-sm" id="passIcon">visibility</span>
                                </button>
                            </div>
                        </div>
                        <div class="space-y-1">
                            <label class="font-label-md text-label-md text-on-surface-variant font-bold tracking-wide uppercase">Gender *</label>
                            <select id="facGender" required class="w-full px-4 py-2.5 rounded-xl border border-outline-variant focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-body-md bg-white">
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>
                        </div>
                    </div>

                    <!-- Error Banner -->
                    <div id="modalErrorBanner" class="hidden text-error bg-error-container/30 border border-error/20 p-3 rounded-xl text-sm text-center font-medium"></div>

                    <div class="flex justify-end items-center gap-3 pt-6 border-t border-outline-variant/20">
                        <button type="button" onclick="toggleRegisterModal(false)" class="px-5 py-2.5 border border-outline-variant text-on-surface-variant font-semibold rounded-xl hover:bg-surface-container transition-all">Cancel</button>
                        <button type="submit" class="px-5 py-2.5 bg-primary text-white font-semibold rounded-xl hover:brightness-110 active:scale-95 transition-all shadow-md">Register Staff</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Delete Faculty Modal Backdrop -->
    <div id="deleteFacultyModal" class="fixed inset-0 overflow-y-auto z-50 hidden" role="dialog" aria-modal="true">
        <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
            <div onclick="toggleDeleteModal(false)" class="fixed inset-0 bg-inverse-surface/30 backdrop-blur-sm transition-opacity" aria-hidden="true"></div>
            <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

            <div class="inline-block align-bottom bg-white rounded-2xl text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-md sm:w-full border border-outline-variant/30">
                <div class="px-6 py-4 border-b border-outline-variant/20 flex justify-between items-center bg-error-container/10">
                    <h3 class="text-lg font-bold text-error flex items-center gap-2">
                        <span class="material-symbols-outlined">warning</span> Verify Faculty Deletion
                    </h3>
                    <button onclick="toggleDeleteModal(false)" class="rounded-md text-on-surface-variant hover:text-on-surface outline-none">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>

                <div class="p-6 space-y-4">
                    <p class="text-sm text-on-surface-variant leading-relaxed">
                        Are you sure you want to permanently remove <strong id="deleteFacName" class="text-on-surface">Faculty Member</strong> from the active staff register? This action cannot be undone.
                    </p>
                    <input type="hidden" id="deleteFacultyId">
                </div>

                <div class="flex justify-end items-center gap-3 p-6 border-t border-outline-variant/20">
                    <button onclick="toggleDeleteModal(false)" class="px-5 py-2.5 border border-outline-variant text-on-surface-variant font-semibold rounded-xl hover:bg-surface-container transition-all">Cancel</button>
                    <button onclick="executeFacultyDelete()" class="px-5 py-2.5 bg-error text-white font-semibold rounded-xl hover:brightness-110 active:scale-95 transition-all shadow-md">Confirm Delete</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        function toggleRegisterModal(open) {
            const modal = document.getElementById('registerModal');
            modal.classList.toggle('hidden', !open);
            if (!open) {
                document.getElementById('facultyForm').reset();
                document.getElementById('modalErrorBanner').classList.add('hidden');
            }
        }

        function togglePass() {
            const pass = document.getElementById('facPass');
            const icon = document.getElementById('passIcon');
            if (pass.type === 'password') {
                pass.type = 'text';
                icon.innerText = 'visibility_off';
            } else {
                pass.type = 'password';
                icon.innerText = 'visibility';
            }
        }

        function toggleDeleteModal(open) {
            const modal = document.getElementById('deleteFacultyModal');
            modal.classList.toggle('hidden', !open);
        }

        function confirmDeleteFaculty(id, name) {
            document.getElementById('deleteFacultyId').value = id;
            document.getElementById('deleteFacName').innerText = name;
            toggleDeleteModal(true);
        }

        async function executeFacultyDelete() {
            const id = document.getElementById('deleteFacultyId').value;
            toggleDeleteModal(false);
            try {
                const res = await fetch(`/api/faculty/${id}`, { method: 'DELETE' });
                if (res.ok) {
                    window.location.reload();
                } else {
                    alert('Failed to delete faculty member.');
                }
            } catch(e) {
                console.error(e);
            }
        }

        async function submitFaculty(e) {
            e.preventDefault();
            const name = document.getElementById('facName').value.trim();
            const secId = document.getElementById('facSecId').value.trim();
            const email = document.getElementById('facEmail').value.trim();
            const department = document.getElementById('facDept').value;
            const password = document.getElementById('facPass').value;
            const gender = document.getElementById('facGender').value;

            const errorBanner = document.getElementById('modalErrorBanner');
            errorBanner.classList.add('hidden');

            try {
                const response = await fetch('/api/faculty/register', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, secId, email, department, password, gender })
                });

                if (response.ok) {
                    window.location.reload();
                } else {
                    const data = await response.json();
                    errorBanner.innerText = data.error || 'Failed to register faculty member.';
                    errorBanner.classList.remove('hidden');
                }
            } catch(err) {
                console.error(err);
                errorBanner.innerText = 'Failed to connect to the server.';
                errorBanner.classList.remove('hidden');
            }
        }
    </script>
</body>
</html>
