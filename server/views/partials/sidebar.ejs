            </a>

        <% } else { %>

            <a href="/faculty/dashboard" class="block px-4 py-3">
                Dashboard
            </a>

            <a href="/faculty/classrooms" class="block px-4 py-3">
                Classrooms
            </a>

            <a href="/faculty/students" class="block px-4 py-3">
