<!-- SideNavBar Partial -->
<aside class="hidden lg:flex flex-col fixed left-0 top-0 h-full bg-white border-r border-gray-200 w-64 z-40">

    <div class="px-6 py-6">
        <h1 class="text-xl font-bold">EduPoll</h1>
        <p class="text-sm text-gray-500">Navigation</p>
    </div>

    <nav class="flex-1 px-4 space-y-2">

        <% if (user && user.role === 'admin') { %>

            <a href="/admin/dashboard" class="block px-4 py-3">
                Dashboard
            </a>

            <a href="/messages" class="block px-4 py-3">
