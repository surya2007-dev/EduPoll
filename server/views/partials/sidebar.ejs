<!-- SideNavBar Partial & Mobile Drawer Overlay -->
<div id="sidebarBackdrop" onclick="toggleAppSidebar(event)" class="fixed inset-0 bg-black/40 backdrop-blur-xs z-45 hidden lg:hidden transition-opacity"></div>

<aside id="mainSidebar" class="flex flex-col fixed left-0 top-0 h-full p-4 bg-white/95 backdrop-blur-xl border-r border-outline-variant/20 shadow-xl w-64 z-50 transition-transform duration-300 -translate-x-full lg:translate-x-0">
    <div class="flex items-center justify-between px-3 py-4 mb-2">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center text-white shadow-sm">
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">school</span>
            </div>
            <div>
                <h1 class="font-headline-md text-headline-md font-bold text-primary leading-tight">EduPoll</h1>
                <p class="font-label-md text-label-md text-on-surface-variant"><%= (user && user.role === 'admin') ? 'Enterprise Admin' : ((user && user.role === 'student') ? 'Student Portal' : 'Faculty Portal') %></p>
            </div>
        </div>
        <!-- Hide / Collapse Button inside left column -->
        <button onclick="toggleAppSidebar(event)" class="p-1.5 text-on-surface-variant hover:bg-surface-container hover:text-primary rounded-lg transition-all flex items-center justify-center cursor-pointer" title="Hide Navigation Sidebar">
            <span class="material-symbols-outlined text-xl">first_page</span>
        </button>
    </div>

    <nav class="mt-4 flex-1 flex flex-col gap-1.5 px-2 overflow-y-auto">
        <% if (user && user.role === 'student') { %>
            <% 
              const isStudDash = (typeof path !== 'undefined' && path.startsWith('/student/dashboard'));
              const isStudPoll = (typeof path !== 'undefined' && path.startsWith('/student/polls'));
              const isStudMent = (typeof path !== 'undefined' && path.startsWith('/student/mentees'));
              const isStudHist = (typeof path !== 'undefined' && path.startsWith('/student/history'));
              const isMsg = (typeof path !== 'undefined' && path.startsWith('/messages'));
            %>

            <a href="/student/dashboard" class="flex items-center gap-3.5 px-4 py-3 rounded-xl transition-all duration-200 <%= isStudDash ? 'bg-primary text-white font-bold shadow-md' : 'text-on-surface-variant hover:text-primary hover:bg-primary/5 font-medium' %>">
                <span class="material-symbols-outlined">dashboard</span>
                <span class="text-sm">Dashboard</span>
            </a>

            <a href="/student/polls" class="flex items-center gap-3.5 px-4 py-3 rounded-xl transition-all duration-200 <%= isStudPoll ? 'bg-primary text-white font-bold shadow-md' : 'text-on-surface-variant hover:text-primary hover:bg-primary/5 font-medium' %>">
                <span class="material-symbols-outlined">poll</span>
                <span class="text-sm">Polls</span>
            </a>

            <a href="/student/mentees" class="flex items-center gap-3.5 px-4 py-3 rounded-xl transition-all duration-200 <%= isStudMent ? 'bg-primary text-white font-bold shadow-md' : 'text-on-surface-variant hover:text-primary hover:bg-primary/5 font-medium' %>">
                <span class="material-symbols-outlined">groups</span>
                <span class="text-sm">Mentorship Group</span>
            </a>

            <a href="/student/history" class="flex items-center gap-3.5 px-4 py-3 rounded-xl transition-all duration-200 <%= isStudHist ? 'bg-primary text-white font-bold shadow-md' : 'text-on-surface-variant hover:text-primary hover:bg-primary/5 font-medium' %>">
                <span class="material-symbols-outlined">history</span>
                <span class="text-sm">Poll History</span>
            </a>

            <a href="/messages" class="flex items-center justify-between gap-3.5 px-4 py-3 rounded-xl transition-all duration-200 <%= isMsg ? 'bg-primary text-white font-bold shadow-md' : 'text-on-surface-variant hover:text-primary hover:bg-primary/5 font-medium' %>">
                <div class="flex items-center gap-3.5">
                    <span class="material-symbols-outlined">chat</span>
                    <span class="text-sm">Messages</span>
                </div>
                <% if (typeof unreadMessagesCount !== 'undefined' && unreadMessagesCount > 0) { %>
                <span class="unread-badge-dot w-2.5 h-2.5 bg-error rounded-full ring-2 ring-white animate-pulse" title="Unread messages"></span>
                <% } %>
            </a>
        <% } else { %>
            <% 
              const dashUrl = (user && user.role === 'admin') ? '/admin/dashboard' : '/faculty/dashboard';
              const classUrl = (user && user.role === 'admin') ? '/admin/classrooms' : '/faculty/classrooms';
              const studUrl = (user && user.role === 'admin') ? '/admin/students' : '/faculty/students';

              const isDash = (typeof path !== 'undefined' && (path.startsWith('/admin/dashboard') || path.startsWith('/faculty/dashboard')));
              const isClass = (typeof path !== 'undefined' && (path.startsWith('/admin/classrooms') || path.startsWith('/faculty/classrooms')));
              const isStud = (typeof path !== 'undefined' && (path.startsWith('/admin/students') || path.startsWith('/faculty/students')));
              const isMent = (typeof path !== 'undefined' && path.startsWith('/faculty/mentees'));
              const isPoll = (typeof path !== 'undefined' && path.startsWith('/faculty/polls'));
              const isRep = (typeof path !== 'undefined' && path.startsWith('/faculty/reports'));
              const isMsg = (typeof path !== 'undefined' && path.startsWith('/messages'));
              const isHelp = (typeof path !== 'undefined' && path.startsWith('/faculty/help'));
            %>

            <a href="<%= dashUrl %>" class="flex items-center gap-3.5 px-4 py-3 rounded-xl transition-all duration-200 <%= isDash ? 'bg-primary text-white font-bold shadow-md' : 'text-on-surface-variant hover:text-primary hover:bg-primary/5 font-medium' %>">
                <span class="material-symbols-outlined">dashboard</span>
                <span class="text-sm">Dashboard</span>
            </a>

            <a href="<%= classUrl %>" class="flex items-center gap-3.5 px-4 py-3 rounded-xl transition-all duration-200 <%= isClass ? 'bg-primary text-white font-bold shadow-md' : 'text-on-surface-variant hover:text-primary hover:bg-primary/5 font-medium' %>">
                <span class="material-symbols-outlined">school</span>
                <span class="text-sm">Classrooms</span>
            </a>

            <a href="<%= studUrl %>" class="flex items-center gap-3.5 px-4 py-3 rounded-xl transition-all duration-200 <%= isStud ? 'bg-primary text-white font-bold shadow-md' : 'text-on-surface-variant hover:text-primary hover:bg-primary/5 font-medium' %>">
                <span class="material-symbols-outlined">person</span>
                <span class="text-sm">Students</span>
            </a>

            <a href="/faculty/mentees" class="flex items-center gap-3.5 px-4 py-3 rounded-xl transition-all duration-200 <%= isMent ? 'bg-primary text-white font-bold shadow-md' : 'text-on-surface-variant hover:text-primary hover:bg-primary/5 font-medium' %>">
                <span class="material-symbols-outlined">group</span>
                <span class="text-sm">Mentees</span>
            </a>

            <a href="/faculty/polls" class="flex items-center gap-3.5 px-4 py-3 rounded-xl transition-all duration-200 <%= isPoll ? 'bg-primary text-white font-bold shadow-md' : 'text-on-surface-variant hover:text-primary hover:bg-primary/5 font-medium' %>">
                <span class="material-symbols-outlined">poll</span>
                <span class="text-sm">Polls</span>
            </a>

            <a href="/faculty/reports" class="flex items-center gap-3.5 px-4 py-3 rounded-xl transition-all duration-200 <%= isRep ? 'bg-primary text-white font-bold shadow-md' : 'text-on-surface-variant hover:text-primary hover:bg-primary/5 font-medium' %>">
                <span class="material-symbols-outlined">analytics</span>
                <span class="text-sm">Reports</span>
            </a>

            <a href="/messages" class="flex items-center justify-between gap-3.5 px-4 py-3 rounded-xl transition-all duration-200 <%= isMsg ? 'bg-primary text-white font-bold shadow-md' : 'text-on-surface-variant hover:text-primary hover:bg-primary/5 font-medium' %>">
                <div class="flex items-center gap-3.5">
                    <span class="material-symbols-outlined">chat</span>
                    <span class="text-sm">Messages</span>
                </div>
                <% if (typeof unreadMessagesCount !== 'undefined' && unreadMessagesCount > 0) { %>
                <span class="unread-badge-dot w-2.5 h-2.5 bg-error rounded-full ring-2 ring-white animate-pulse" title="Unread messages"></span>
                <% } %>
            </a>
        <% } %>
    </nav>

    <div class="mt-auto px-2 pb-4 border-t border-outline-variant/20 pt-4 space-y-1.5">
        <% if (user && user.role === 'student') { %>
            <a href="/student/profile" class="flex items-center gap-3.5 px-4 py-3 rounded-xl transition-all duration-200 text-on-surface-variant hover:text-primary hover:bg-primary/5 font-medium">
                <span class="material-symbols-outlined">person</span>
                <span class="text-sm">My Profile</span>
            </a>
        <% } else { %>
            <a href="/faculty/help" class="flex items-center gap-3.5 px-4 py-3 rounded-xl transition-all duration-200 text-on-surface-variant hover:text-primary hover:bg-primary/5 font-medium">
                <span class="material-symbols-outlined">help</span>
                <span class="text-sm">Help</span>
            </a>
        <% } %>
        <a href="/api/auth/logout" class="flex items-center gap-3.5 px-4 py-3 text-error hover:bg-error/10 font-bold transition-all duration-200 rounded-xl">
            <span class="material-symbols-outlined text-error">logout</span>
            <span class="text-sm">Logout</span>
        </a>
    </div>
</aside>

<script>
function toggleAppSidebar(e) {
    if (e) e.stopPropagation();
    const sidebar = document.getElementById('mainSidebar');
    const backdrop = document.getElementById('sidebarBackdrop');
    const header = document.getElementById('topHeader');
    const icon = document.getElementById('sidebarToggleIcon');

    if (!sidebar) return;

    const isMobile = window.innerWidth < 1024;

    if (isMobile) {
        // Mobile Drawer behavior
        const isOpen = !sidebar.classList.contains('-translate-x-full');
        if (isOpen) {
            sidebar.classList.add('-translate-x-full');
            if (backdrop) backdrop.classList.add('hidden');
        } else {
            sidebar.classList.remove('-translate-x-full');
            if (backdrop) backdrop.classList.remove('hidden');
        }
    } else {
        // Desktop Hide/Unhide behavior
        const isHidden = sidebar.classList.contains('lg:-translate-x-full');
        if (isHidden) {
            // Unhide sidebar
            sidebar.classList.remove('lg:-translate-x-full');
            if (header) header.classList.add('lg:pl-[280px]');
            document.querySelectorAll('main').forEach(m => m.classList.add('lg:pl-[280px]'));
            if (icon) icon.textContent = 'menu_open';
            localStorage.setItem('eduPollSidebarHidden', 'false');
        } else {
            // Hide sidebar
            sidebar.classList.add('lg:-translate-x-full');
            if (header) header.classList.remove('lg:pl-[280px]');
            document.querySelectorAll('main').forEach(m => m.classList.remove('lg:pl-[280px]'));
            if (icon) icon.textContent = 'menu';
            localStorage.setItem('eduPollSidebarHidden', 'true');
        }
    }
}

// Ensure proper initial layout and persistence on page load
document.addEventListener('DOMContentLoaded', () => {
    const sidebar = document.getElementById('mainSidebar');
    const header = document.getElementById('topHeader');
    const icon = document.getElementById('sidebarToggleIcon');
    const isHidden = localStorage.getItem('eduPollSidebarHidden') === 'true';

    if (window.innerWidth >= 1024) {
        if (isHidden && sidebar) {
            sidebar.classList.add('lg:-translate-x-full');
            if (header) header.classList.remove('lg:pl-[280px]');
            document.querySelectorAll('main').forEach(m => m.classList.remove('lg:pl-[280px]'));
            if (icon) icon.textContent = 'menu';
        } else if (icon) {
            icon.textContent = 'menu_open';
        }
    }
});
</script>