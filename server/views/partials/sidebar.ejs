            </a>

            <a href="/faculty/mentees" class="block px-4 py-3">
                Mentees
            </a>

            <a href="/faculty/polls" class="block px-4 py-3">
                Polls
            </a>

            <a href="/faculty/reports" class="block px-4 py-3">
                Reports
            </a>

            <a href="/messages" class="block px-4 py-3">
                Messages
            </a>

        <% } %>

    </nav>

    <div class="px-4 pb-6">
        <a href="/faculty/help" class="block px-4 py-3">
            Help
        </a>

        <a href="/api/auth/logout" class="block px-4 py-3">
