<%- include('partials/head') %>
<body class="bg-background min-h-screen">
    <!-- Navigation Shared Partials -->
    <%- include('partials/sidebar') %>
    <%- include('partials/header') %>

    <!-- Main Content Canvas -->
    <main class="pt-24 pb-20 px-margin-mobile md:px-margin-desktop lg:pl-[280px]">
        <div class="max-w-[1440px] mx-auto space-y-6">
            <!-- Header section -->
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white p-6 rounded-2xl border border-outline-variant/30 shadow-sm">
                <div>
                    <h1 class="text-2xl font-bold text-on-surface">Registered Student Registry</h1>
                    <p class="text-on-surface-variant text-sm mt-1">Review student enrollment details, academic paths, and active sessions.</p>
                </div>
            </div>

            <!-- Back to dashboard link -->
            <div>
                <a href="/admin/dashboard" class="text-xs font-bold text-primary flex items-center gap-1 hover:underline">
                    <span class="material-symbols-outlined text-xs">arrow_back</span> Back to Administrative Overview
                </a>
            </div>

            <!-- Table -->
            <div class="bg-white rounded-2xl border border-outline-variant/30 shadow-sm overflow-hidden animate-fade-in">
                <div class="px-6 py-4 border-b border-outline-variant/20 flex justify-between items-center">
                    <h4 class="font-bold text-on-surface font-headline-sm">Student Registry</h4>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse" id="studentsTable">
                        <thead>
                            <tr class="bg-surface-container-high/30">
                                <th class="px-6 py-4 font-label-md text-on-surface-variant border-b border-outline-variant/20">Name</th>
                                <th class="px-6 py-4 font-label-md text-on-surface-variant border-b border-outline-variant/20">SEC ID / Roll No</th>
                                <th class="px-6 py-4 font-label-md text-on-surface-variant border-b border-outline-variant/20">Email</th>
                                <th class="px-6 py-4 font-label-md text-on-surface-variant border-b border-outline-variant/20">Gender</th>
                                <th class="px-6 py-4 font-label-md text-on-surface-variant border-b border-outline-variant/20">Department & Class</th>
                                <th class="px-6 py-4 font-label-md text-on-surface-variant border-b border-outline-variant/20">Academic Session</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-outline-variant/10">
                            <% if (students.length === 0) { %>
                                <tr>
                                    <td colspan="6" class="px-6 py-12 text-center text-on-surface-variant italic bg-white">No registered students found.</td>
                                </tr>
                            <% } else { %>
                                <% students.forEach(student => { %>
                                    <tr class="hover:bg-primary-container/5 transition-colors">
                                        <td class="px-6 py-4">
                                            <div class="flex items-center gap-3">
                                                <div class="w-9 h-9 rounded-full bg-surface-container flex items-center justify-center font-bold text-primary border border-outline-variant/20">
                                                    <%= student.name.charAt(0) %>
                                                </div>
                                                <div>
                                                    <p class="font-semibold text-on-surface text-sm"><%= student.name %></p>
                                                    <span class="text-[9px] px-1.5 py-0.5 bg-surface-container text-on-surface-variant rounded border border-outline-variant/20 font-bold uppercase tracking-wider"><%= student.status %></span>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="px-6 py-4 font-code text-xs text-on-surface-variant font-bold"><%= student.secId %></td>
                                        <td class="px-6 py-4 text-sm text-on-surface-variant"><%= student.email %></td>
                                        <td class="px-6 py-4 text-sm text-on-surface-variant font-medium"><%= student.gender || 'Male' %></td>
                                        <td class="px-6 py-4 text-xs font-semibold text-primary">
                                            <div><%= student.department %></div>
                                            <% if (student.classroom) { %>
                                                <div class="text-[10px] text-on-surface-variant/80 font-normal mt-0.5">Assigned: <%= student.classroom.name %> (<%= student.classroom.subject %>)</div>
                                            <% } else { %>
                                                <span class="text-[10px] text-error font-normal mt-0.5">Unassigned</span>
                                            <% } %>
                                        </td>
                                        <td class="px-6 py-4 text-xs text-on-surface-variant font-bold uppercase">
                                            <%= student.year %> • Sec <%= student.section %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
</body>
</html>
