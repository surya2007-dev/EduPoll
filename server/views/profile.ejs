<%- include('partials/head') %>
<body class="bg-background min-h-screen">
    <!-- Navigation Shared Partials -->
    <%- include('partials/sidebar') %>
    <%- include('partials/header') %>

    <!-- Main Content Canvas -->
    <main class="pt-24 pb-20 px-margin-mobile md:px-margin-desktop lg:pl-[280px] min-h-screen flex flex-col gap-8 items-center justify-start">
        <!-- Profile Container Card -->
        <section class="w-full max-w-2xl bg-white border border-outline-variant/30 rounded-2xl shadow-xl overflow-hidden p-0 hover-scale animate-fade-in">
            <!-- Header Banner -->
            <div class="px-8 py-5 border-b border-outline-variant/20 flex justify-between items-center bg-surface-container-low/50">
                <h3 class="text-lg font-bold text-on-surface flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">person</span> User Settings Profile
                </h3>
                <a href="<%= (user && user.role === 'admin') ? '/admin/dashboard' : '/faculty/dashboard' %>" class="text-on-surface-variant hover:text-on-surface transition-all">
                    <span class="material-symbols-outlined">close</span>
                </a>
            </div>

            <!-- Profile Form -->
            <form class="p-8 space-y-6" id="profileUpdateForm" onsubmit="handleProfileUpdate(event)">
                <!-- Visual Profile Card Overview with Photo Upload -->
                <div class="flex flex-col sm:flex-row items-center gap-6 p-6 bg-primary-container/10 border border-primary/10 rounded-2xl">
                    <div class="relative group cursor-pointer shrink-0" onclick="triggerPhotoSelect()">
                        <div class="w-20 h-20 rounded-full overflow-hidden border-2 border-primary flex items-center justify-center bg-primary text-white text-2xl font-bold shadow-md relative">
                            <img id="avatarPreview" class="w-full h-full object-cover <%= (user && user.profilePhoto) ? '' : 'hidden' %>" src="<%= (user && user.profilePhoto) ? user.profilePhoto : '' %>" alt="Profile Preview">
                            <span id="avatarInitials" class="<%= (user && user.profilePhoto) ? 'hidden' : '' %>"><%= user ? user.name.charAt(0) : 'A' %></span>
                            <div class="absolute inset-0 bg-inverse-surface/50 flex flex-col items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                                <span class="material-symbols-outlined text-white text-lg">photo_camera</span>
                                <span class="text-[8px] text-white font-bold uppercase tracking-wider mt-0.5">Upload</span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="flex-1 text-center sm:text-left space-y-1">
                        <h4 class="text-lg font-bold text-on-surface"><%= user ? user.name : 'Administrator' %></h4>
                        <p class="text-xs text-on-surface-variant font-semibold uppercase tracking-wider"><%= user ? user.role : 'Faculty' %> • <%= user ? user.department : 'Academic' %> Dept.</p>
                        <button type="button" onclick="triggerPhotoSelect()" class="px-3 py-1.5 bg-primary text-white text-xs font-bold rounded-lg hover:shadow-sm transition-all focus:outline-none mt-2">
                            Upload Avatar Photo
                        </button>
                        <input type="file" id="profilePhotoFile" accept="image/*" class="hidden" onchange="handlePhotoChange(this)">
                        <input type="hidden" id="profilePhotoVal" value="<%= user ? user.profilePhoto : '' %>">
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div class="space-y-1">
                        <label class="font-label-md text-label-md text-on-surface-variant font-bold tracking-wide uppercase">Full Name *</label>
                        <input type="text" id="profileName" required value="<%= user ? user.name : '' %>" class="w-full px-4 py-2.5 rounded-xl border border-outline-variant focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-body-md">
                    </div>
                    <div class="space-y-1">
                        <label class="font-label-md text-label-md text-on-surface-variant font-bold tracking-wide uppercase">Workspace User ID / SEC ID *</label>
                        <input type="text" id="profileSecId" required value="<%= user ? user.secId : '' %>" class="w-full px-4 py-2.5 rounded-xl border border-outline-variant focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-body-md">
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div class="space-y-1">
                        <label class="font-label-md text-label-md text-on-surface-variant font-bold tracking-wide uppercase">Institutional Email Address *</label>
                        <input type="email" id="profileEmail" required value="<%= user ? user.email : '' %>" class="w-full px-4 py-2.5 rounded-xl border border-outline-variant focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-body-md">
                    </div>
                    <div class="space-y-1">
                        <label class="font-label-md text-label-md text-on-surface-variant font-bold tracking-wide uppercase">Academic Department *</label>
                        <input type="text" id="profileDept" required value="<%= user ? user.department : '' %>" class="w-full px-4 py-2.5 rounded-xl border border-outline-variant focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-body-md">
                    </div>
                </div>

                <!-- Security Authorization & Update Passwords -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 border-t border-outline-variant/20 pt-6">
                    <div class="space-y-1">
                        <label class="font-label-md text-label-md text-on-surface-variant font-bold tracking-wide uppercase">Current Password *</label>
                        <div class="relative">
                            <input type="password" id="profileCurrentPass" required placeholder="Enter current password" class="w-full px-4 py-2.5 rounded-xl border border-outline-variant focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-body-md">
                            <button type="button" onclick="toggleCurrentPassView()" class="absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant/50 hover:text-on-surface transition-all">
                                <span class="material-symbols-outlined text-sm" id="currentPassIcon">visibility</span>
                            </button>
                        </div>
                    </div>
                    <div class="space-y-1">
                        <label class="font-label-md text-label-md text-on-surface-variant font-bold tracking-wide uppercase">New Security Password</label>
                        <div class="relative">
                            <input type="password" id="profilePass" placeholder="Enter new password" class="w-full px-4 py-2.5 rounded-xl border border-outline-variant focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-body-md">
                            <button type="button" onclick="togglePassView()" class="absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant/50 hover:text-on-surface transition-all">
                                <span class="material-symbols-outlined text-sm" id="passIcon">visibility</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Error / Success Feedback Banner -->
                <div id="errorBanner" class="hidden text-error bg-error-container/30 border border-error/20 p-3 rounded-xl text-sm text-center font-medium"></div>
                <div id="successBanner" class="hidden text-green-700 bg-green-100 border border-green-200 p-3 rounded-xl text-sm text-center font-medium"></div>

                <!-- Actions Footer -->
                <div class="flex justify-end items-center gap-3 pt-6 border-t border-outline-variant/20">
                    <a href="<%= (user && user.role === 'admin') ? '/admin/dashboard' : '/faculty/dashboard' %>" class="px-5 py-2.5 border border-outline-variant text-on-surface-variant font-semibold rounded-xl hover:bg-surface-container transition-all">Cancel</a>
                    <button type="submit" class="px-5 py-2.5 bg-primary text-white font-semibold rounded-xl hover:brightness-110 active:scale-95 transition-all shadow-md">Save Changes</button>
                </div>
            </form>
        </section>

        <% if (user && user.role === 'admin') { %>
        <!-- Master Filter Directory Container -->
        <section class="w-full max-w-5xl bg-white border border-outline-variant/30 rounded-2xl shadow-xl overflow-hidden p-0 animate-fade-in">
            <!-- Header -->
            <div class="px-8 py-5 border-b border-outline-variant/20 bg-surface-container-low/50">
                <h3 class="text-lg font-bold text-on-surface flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">manage_accounts</span> Master User Directory
                </h3>
                <p class="text-xs text-on-surface-variant mt-1">Filter, sort, and query all academic registry profiles (Faculty & Students).</p>
            </div>

            <!-- Filters Grid -->
            <div class="p-6 bg-surface-container/20 border-b border-outline-variant/10 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-4">
                <!-- Role Filter -->
                <div class="space-y-1">
                    <label class="text-[10px] uppercase font-bold text-on-surface-variant">Filter Role</label>
                    <select id="filterRole" onchange="applyMasterFilters()" class="w-full px-3 py-2 rounded-xl border border-outline-variant bg-white text-xs outline-none">
                        <option value="ALL">All Roles</option>
                        <option value="faculty">Faculty / Staff</option>
                        <option value="student">Student</option>
                    </select>
                </div>
                <!-- Department Filter -->
                <div class="space-y-1">
                    <label class="text-[10px] uppercase font-bold text-on-surface-variant">Department</label>
                    <select id="filterDept" onchange="applyMasterFilters()" class="w-full px-3 py-2 rounded-xl border border-outline-variant bg-white text-xs outline-none">
                        <option value="ALL">All Departments</option>
                        <option value="B.E. - Mechanical Engineering">B.E. - Mechanical Engineering</option>
                        <option value="B.E. - Electronics & Communication Engineering">B.E. - Electronics & Communication Engineering</option>
                        <option value="B.E. - Electrical & Electronics Engineering">B.E. - Electrical & Electronics Engineering</option>
                        <option value="B.E. - Computer Science & Engineering">B.E. - Computer Science & Engineering</option>
                        <option value="B.E. - Instrumentation & Controls Engineering">B.E. - Instrumentation & Controls Engineering</option>
                        <option value="B.Tech. - Information Technology">B.Tech. - Information Technology</option>
                        <option value="B.E. - Civil Engineering">B.E. - Civil Engineering</option>
                        <option value="B.E. - Electronics & Instrumentation Engineering">B.E. - Electronics & Instrumentation Engineering</option>
                        <option value="B.E. - Production Engineering">B.E. - Production Engineering</option>
                    </select>
                </div>
                <!-- Gender Filter -->
                <div class="space-y-1">
                    <label class="text-[10px] uppercase font-bold text-on-surface-variant">Gender</label>
                    <select id="filterGender" onchange="applyMasterFilters()" class="w-full px-3 py-2 rounded-xl border border-outline-variant bg-white text-xs outline-none">
                        <option value="ALL">All Genders</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                    </select>
                </div>
                <!-- Year Filter (for Students) -->
                <div class="space-y-1">
                    <label class="text-[10px] uppercase font-bold text-on-surface-variant">Academic Year</label>
                    <select id="filterYear" onchange="applyMasterFilters()" class="w-full px-3 py-2 rounded-xl border border-outline-variant bg-white text-xs outline-none">
                        <option value="ALL">All Years</option>
                        <option value="Year 1">Year 1</option>
                        <option value="Year 2">Year 2</option>
                        <option value="Year 3">Year 3</option>
                        <option value="Year 4">Year 4</option>
                    </select>
                </div>
                <!-- Semester Filter -->
                <div class="space-y-1">
                    <label class="text-[10px] uppercase font-bold text-on-surface-variant">Semester</label>
                    <select id="filterSemester" onchange="applyMasterFilters()" class="w-full px-3 py-2 rounded-xl border border-outline-variant bg-white text-xs outline-none">
                        <option value="ALL">All Semesters</option>
                        <option value="1st">1st</option>
                        <option value="2nd">2nd</option>
                        <option value="3rd">3rd</option>
                        <option value="4th">4th</option>
                        <option value="5th">5th</option>
                        <option value="6th">6th</option>
                        <option value="7th">7th</option>
                        <option value="8th">8th</option>
                    </select>
                </div>
            </div>

            <!-- Table Roster -->
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse" id="masterRosterTable">
                    <thead>
                        <tr class="bg-surface-container-high/30">
                            <th class="px-6 py-4 font-label-md text-on-surface-variant border-b border-outline-variant/20">User Profile</th>
                            <th class="px-6 py-4 font-label-md text-on-surface-variant border-b border-outline-variant/20">Role</th>
                            <th class="px-6 py-4 font-label-md text-on-surface-variant border-b border-outline-variant/20">ID / SEC ID</th>
                            <th class="px-6 py-4 font-label-md text-on-surface-variant border-b border-outline-variant/20">Gender</th>
                            <th class="px-6 py-4 font-label-md text-on-surface-variant border-b border-outline-variant/20">Department</th>
                            <th class="px-6 py-4 font-label-md text-on-surface-variant border-b border-outline-variant/20">Academic Info</th>
                            <th class="px-6 py-4 font-label-md text-on-surface-variant border-b border-outline-variant/20">Email</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-outline-variant/10">
                        <!-- Render Faculties -->
                        <% faculties.forEach(fac => { %>
                            <tr class="hover:bg-primary-container/5 transition-colors roster-row" 
                                data-role="faculty" 
                                data-dept="<%= fac.department %>" 
                                data-gender="<%= fac.gender || 'Male' %>"
                                data-year="None"
                                data-semester="None">
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-full bg-surface-container flex items-center justify-center font-bold text-primary border border-outline-variant/20">
                                            <%= fac.name.charAt(0) %>
                                        </div>
                                        <p class="font-semibold text-on-surface text-sm"><%= fac.name %></p>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-xs font-bold text-primary uppercase">Faculty</td>
                                <td class="px-6 py-4 font-code text-xs text-on-surface-variant font-bold"><%= fac.secId %></td>
                                <td class="px-6 py-4 text-sm text-on-surface-variant font-medium"><%= fac.gender || 'Male' %></td>
                                <td class="px-6 py-4 text-xs font-semibold text-on-surface-variant"><%= fac.department %></td>
                                <td class="px-6 py-4 text-xs text-on-surface-variant/70 italic">N/A</td>
                                <td class="px-6 py-4 text-xs text-on-surface-variant"><%= fac.email %></td>
                            </tr>
                        <% }) %>

                        <!-- Render Students -->
                        <% students.forEach(student => { %>
                            <tr class="hover:bg-primary-container/5 transition-colors roster-row" 
                                data-role="student" 
                                data-dept="<%= student.department %>" 
                                data-gender="<%= student.gender || 'Male' %>"
                                data-year="<%= student.year %>"
                                data-semester="<%= student.classroom ? student.classroom.semester : 'None' %>">
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-full bg-surface-container flex items-center justify-center font-bold text-primary border border-outline-variant/20">
                                            <%= student.name.charAt(0) %>
                                        </div>
                                        <p class="font-semibold text-on-surface text-sm"><%= student.name %></p>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-xs font-bold text-on-surface-variant uppercase">Student</td>
                                <td class="px-6 py-4 font-code text-xs text-on-surface-variant font-bold"><%= student.secId %></td>
                                <td class="px-6 py-4 text-sm text-on-surface-variant font-medium"><%= student.gender || 'Male' %></td>
                                <td class="px-6 py-4 text-xs font-semibold text-on-surface-variant"><%= student.department %></td>
                                <td class="px-6 py-4 text-xs text-on-surface font-medium leading-relaxed">
                                    <div><%= student.year %> • Sec <%= student.section %></div>
                                    <% if (student.classroom) { %>
                                        <div class="text-[10px] text-primary">Class: <%= student.classroom.name %> (Sem <%= student.classroom.semester %>)</div>
                                    <% } else { %>
                                        <div class="text-[10px] text-error">Unassigned</div>
                                    <% } %>
                                </td>
                                <td class="px-6 py-4 text-xs text-on-surface-variant"><%= student.email %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </section>
        <% } %>
    </main>

    <script>
        function togglePassView() {
            const pass = document.getElementById('profilePass');
            const icon = document.getElementById('passIcon');
            if (pass.type === 'password') {
                pass.type = 'text';
                icon.innerText = 'visibility_off';
            } else {
                pass.type = 'password';
                icon.innerText = 'visibility';
            }
        }

        function toggleCurrentPassView() {
            const pass = document.getElementById('profileCurrentPass');
            const icon = document.getElementById('currentPassIcon');
            if (pass.type === 'password') {
                pass.type = 'text';
                icon.innerText = 'visibility_off';
            } else {
                pass.type = 'password';
                icon.innerText = 'visibility';
            }
        }

        async function handleProfileUpdate(e) {
            e.preventDefault();
            const name = document.getElementById('profileName').value.trim();
            const secId = document.getElementById('profileSecId').value.trim();
            const email = document.getElementById('profileEmail').value.trim();
            const department = document.getElementById('profileDept').value.trim();
            const password = document.getElementById('profilePass').value;
            const currentPassword = document.getElementById('profileCurrentPass').value;
            const profilePhoto = document.getElementById('profilePhotoVal').value;

            const errorBanner = document.getElementById('errorBanner');
            const successBanner = document.getElementById('successBanner');
            errorBanner.classList.add('hidden');
            successBanner.classList.add('hidden');

            try {
                const response = await fetch('/api/faculty/profile', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, secId, email, department, password, profilePhoto, currentPassword })
                });

                if (response.ok) {
                    successBanner.innerText = "Profile updated successfully! Refreshing details...";
                    successBanner.classList.remove('hidden');
                    setTimeout(() => {
                        window.location.reload();
                    }, 1200);
                } else {
                    const data = await response.json();
                    errorBanner.innerText = data.error || 'Failed to update profile settings.';
                    errorBanner.classList.remove('hidden');
                }
            } catch(err) {
                console.error(err);
                errorBanner.innerText = 'Connection error. Please try again.';
                errorBanner.classList.remove('hidden');
            }
        }

        function triggerPhotoSelect() {
            document.getElementById('profilePhotoFile').click();
        }

        function handlePhotoChange(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    // Update preview and set hidden value
                    const base64 = e.target.result;
                    document.getElementById('avatarPreview').src = base64;
                    document.getElementById('avatarPreview').classList.remove('hidden');
                    document.getElementById('avatarInitials').classList.add('hidden');
                    document.getElementById('profilePhotoVal').value = base64;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function applyMasterFilters() {
            const role = document.getElementById('filterRole').value;
            const dept = document.getElementById('filterDept').value;
            const gender = document.getElementById('filterGender').value;
            const year = document.getElementById('filterYear').value;
            const semester = document.getElementById('filterSemester').value;

            const rows = document.querySelectorAll('.roster-row');
            rows.forEach(row => {
                const rowRole = row.getAttribute('data-role');
                const rowDept = row.getAttribute('data-dept');
                const rowGender = row.getAttribute('data-gender');
                const rowYear = row.getAttribute('data-year');
                const rowSemester = row.getAttribute('data-semester');

                const matchesRole = role === 'ALL' || rowRole === role;
                const matchesDept = dept === 'ALL' || rowDept === dept;
                const matchesGender = gender === 'ALL' || rowGender === gender;
                const matchesYear = year === 'ALL' || rowRole === 'faculty' || rowYear === year;
                const matchesSemester = semester === 'ALL' || rowRole === 'faculty' || rowSemester === semester;

                if (matchesRole && matchesDept && matchesGender && matchesYear && matchesSemester) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }
    </script>
</body>
</html>
