<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Profile - EduPoll Student Portal</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#1E40AF',
                        'primary-container': '#DBEAFE',
                        'on-primary-container': '#1E3A8A',
                        secondary: '#475569',
                        tertiary: '#0F766E',
                        'tertiary-container': '#CCFBF1',
                        'on-tertiary-container': '#115E59',
                        surface: '#F8FAFC',
                        'surface-container-lowest': '#FFFFFF',
                        'surface-container-low': '#F1F5F9',
                        'on-surface': '#0F172A',
                        'on-surface-variant': '#64748B',
                        'outline-variant': '#E2E8F0',
                        error: '#EF4444',
                        'error-container': '#FEE2E2',
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                        code: ['JetBrains Mono', 'monospace'],
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-surface font-sans text-on-surface min-h-screen flex flex-col">

    <!-- Header -->
    <header class="h-16 border-b border-outline-variant/40 bg-surface-container-lowest/80 backdrop-blur-md fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-6">
        <div class="flex items-center gap-3">
            <a href="/student/polls" class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-2xl">school</span>
                <span class="font-extrabold text-lg tracking-tight text-on-surface">EduPoll</span>
                <span class="text-xs bg-primary/10 text-primary px-2 py-0.5 rounded-full font-bold ml-1">Student Portal</span>
            </a>
        </div>

        <!-- Student Nav & User Menu -->
        <div class="flex items-center gap-2">
            <a href="/student/polls" class="flex items-center gap-1.5 px-3 py-1.5 border border-outline-variant hover:bg-primary-container/10 transition-all text-xs font-bold text-primary rounded-xl">
                <span class="material-symbols-outlined text-xs">poll</span> Polls
            </a>
            <a href="/student/mentees" class="flex items-center gap-1.5 px-3 py-1.5 border border-outline-variant hover:bg-tertiary-container/10 transition-all text-xs font-bold text-tertiary rounded-xl">
                <span class="material-symbols-outlined text-xs">groups</span> Mentorship Group
            </a>
            <a href="/student/history" class="flex items-center gap-1.5 px-3 py-1.5 border border-outline-variant hover:bg-primary-container/10 transition-all text-xs font-bold text-primary rounded-xl">
                <span class="material-symbols-outlined text-xs">history</span> Poll History
            </a>
            <a href="/messages" class="relative flex items-center gap-1.5 px-3 py-1.5 border border-outline-variant hover:bg-primary-container/10 transition-all text-xs font-bold text-primary rounded-xl">
                <span class="material-symbols-outlined text-xs">chat</span> Messages
                <% if (typeof unreadMessagesCount !== 'undefined' && unreadMessagesCount > 0) { %>
                <span class="unread-badge-dot absolute -top-1 -right-1 w-2.5 h-2.5 bg-error rounded-full ring-2 ring-white animate-pulse" title="Unread messages"></span>
                <% } %>
            </a>

            <!-- User Menu Dropdown trigger (ONLY Name + Logo, no SEC ID) -->
            <div class="relative">
                <button onclick="toggleStudentUserMenu(event)" class="flex items-center gap-2 px-2.5 py-1.5 rounded-xl hover:bg-surface-container-low border border-transparent hover:border-outline-variant transition-all cursor-pointer">
                    <div class="w-8 h-8 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center font-bold text-xs shadow-sm">
                        <%= user ? user.name.charAt(0) : 'S' %>
                    </div>
                    <span class="text-sm font-semibold text-on-surface"><%= user ? user.name : 'Student' %></span>
                    <span class="material-symbols-outlined text-sm text-on-surface-variant">expand_more</span>
                </button>

                <!-- Dropdown Menu -->
                <div id="studentUserMenu" class="hidden absolute right-0 mt-2 w-52 bg-white border border-outline-variant/60 rounded-2xl shadow-xl py-2 z-50 animate-fade-in">
                    <div class="px-4 py-2 border-b border-outline-variant/30 mb-1">
                        <p class="text-xs font-bold text-on-surface"><%= user ? user.name : 'Student' %></p>
                        <p class="text-[11px] text-on-surface-variant truncate"><%= user ? user.email : '' %></p>
                    </div>
                    <a href="/student/profile" class="flex items-center gap-2.5 px-4 py-2.5 text-xs font-bold text-primary hover:bg-primary/5 transition-all">
                        <span class="material-symbols-outlined text-base">person</span> My Profile
                    </a>
                    <a href="/api/auth/logout" class="flex items-center gap-2.5 px-4 py-2.5 text-xs font-bold text-error hover:bg-error/5 transition-all">
                        <span class="material-symbols-outlined text-base">logout</span> Logout
                    </a>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="pt-24 pb-20 px-6 max-w-[1000px] mx-auto w-full flex-1">
        <div class="space-y-8 animate-fade-in">
            <!-- Page Title -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-outline-variant/40 pb-6">
                <div>
                    <h1 class="text-2xl font-extrabold text-on-surface flex items-center gap-2.5">
                        <span class="material-symbols-outlined text-primary text-3xl">badge</span> My Profile & Details
                    </h1>
                    <p class="text-sm text-on-surface-variant mt-1">View your official student credentials, academic enrollment details, and assigned faculty mentor.</p>
                </div>
                <a href="/student/polls" class="inline-flex items-center gap-2 px-4 py-2 bg-surface-container-low hover:bg-surface-container border border-outline-variant text-xs font-bold text-on-surface rounded-xl transition-all">
                    <span class="material-symbols-outlined text-sm">arrow_back</span> Back to Portal
                </a>
            </div>

            <!-- Grid Layout -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Left Column: Student Card -->
                <div class="bg-white border border-outline-variant/40 rounded-3xl p-6 shadow-sm flex flex-col items-center text-center">
                    <div class="w-24 h-24 rounded-full bg-gradient-to-br from-primary to-primary/80 text-white flex items-center justify-center font-extrabold text-3xl shadow-lg mb-4">
                        <%= user ? user.name.charAt(0) : 'S' %>
                    </div>
                    <h2 class="text-lg font-extrabold text-on-surface"><%= user ? user.name : 'Student' %></h2>
                    <span class="inline-block mt-1 px-3 py-1 bg-primary/10 text-primary text-xs font-code font-bold rounded-full">
                        <%= user ? user.secId : 'SEC ID N/A' %>
                    </span>

                    <div class="w-full border-t border-outline-variant/30 my-6 pt-6 space-y-3 text-left">
                        <div class="flex justify-between items-center text-xs">
                            <span class="text-on-surface-variant font-medium">Role</span>
                            <span class="font-bold text-on-surface px-2 py-0.5 bg-surface-container rounded">Student</span>
                        </div>
                        <div class="flex justify-between items-center text-xs">
                            <span class="text-on-surface-variant font-medium">Year</span>
                            <span class="font-bold text-on-surface"><%= user ? (user.year || 'N/A') : 'N/A' %></span>
                        </div>
                        <div class="flex justify-between items-center text-xs">
                            <span class="text-on-surface-variant font-medium">Section</span>
                            <span class="font-bold text-on-surface"><%= user ? (user.section || 'N/A') : 'N/A' %></span>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Details & Mentor Info -->
                <div class="md:col-span-2 space-y-6">
                    <!-- Academic Enrollment Card -->
                    <div class="bg-white border border-outline-variant/40 rounded-3xl p-6 shadow-sm">
                        <h3 class="text-base font-extrabold text-on-surface flex items-center gap-2 mb-4">
                            <span class="material-symbols-outlined text-primary">school</span> Academic Enrollment Information
                        </h3>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div class="p-4 rounded-2xl bg-surface-container-low/60 border border-outline-variant/30">
                                <p class="text-[11px] font-bold uppercase tracking-wider text-on-surface-variant">Department</p>
                                <p class="text-sm font-extrabold text-on-surface mt-1"><%= user ? (user.department || 'Computer Science') : 'N/A' %></p>
                            </div>
                            <div class="p-4 rounded-2xl bg-surface-container-low/60 border border-outline-variant/30">
                                <p class="text-[11px] font-bold uppercase tracking-wider text-on-surface-variant">Classroom / Batch</p>
                                <p class="text-sm font-extrabold text-on-surface mt-1">
                                    <%= (user && user.classroom && user.classroom.name) ? user.classroom.name : (user && user.classroom ? user.classroom.code || 'Assigned' : 'Not assigned to Classroom') %>
                                </p>
                            </div>
                            <div class="p-4 rounded-2xl bg-surface-container-low/60 border border-outline-variant/30">
                                <p class="text-[11px] font-bold uppercase tracking-wider text-on-surface-variant">Email Address</p>
                                <p class="text-sm font-bold text-on-surface mt-1 truncate"><%= user ? (user.email || 'Not Provided') : 'N/A' %></p>
                            </div>
                            <div class="p-4 rounded-2xl bg-surface-container-low/60 border border-outline-variant/30">
                                <p class="text-[11px] font-bold uppercase tracking-wider text-on-surface-variant">SEC ID</p>
                                <p class="text-sm font-code font-bold text-primary mt-1"><%= user ? user.secId : 'N/A' %></p>
                            </div>
                        </div>
                    </div>

                    <!-- Faculty Mentor Card -->
                    <div class="bg-gradient-to-br from-tertiary-container/30 to-white border border-tertiary/20 rounded-3xl p-6 shadow-sm">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="text-base font-extrabold text-tertiary flex items-center gap-2">
                                <span class="material-symbols-outlined text-tertiary">support_agent</span> Assigned Faculty Mentor
                            </h3>
                            <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-tertiary/10 text-tertiary">Official Mentor</span>
                        </div>

                        <% if (typeof mentor !== 'undefined' && mentor) { %>
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 rounded-2xl bg-white border border-outline-variant/40 shadow-sm">
                                <div class="flex items-center gap-3.5">
                                    <div class="w-12 h-12 rounded-2xl bg-tertiary/10 text-tertiary flex items-center justify-center font-extrabold text-lg">
                                        <%= mentor.name ? mentor.name.charAt(0) : 'M' %>
                                    </div>
                                    <div>
                                        <p class="font-extrabold text-on-surface text-base"><%= mentor.name %></p>
                                        <p class="text-xs text-on-surface-variant"><%= mentor.department || 'Faculty Mentor' %></p>
                                        <p class="text-xs text-on-surface-variant mt-0.5"><%= mentor.email || '' %></p>
                                    </div>
                                </div>
                                <a href="/messages" class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-tertiary text-white hover:brightness-110 font-bold text-xs rounded-xl shadow transition-all shrink-0">
                                    <span class="material-symbols-outlined text-sm">chat</span> Message Mentor
                                </a>
                            </div>
                        <% } else { %>
                            <div class="p-6 rounded-2xl bg-white/80 border border-dashed border-outline-variant text-center">
                                <span class="material-symbols-outlined text-3xl text-on-surface-variant/50">person_off</span>
                                <p class="text-sm font-bold text-on-surface mt-2">No Mentor Currently Assigned</p>
                                <p class="text-xs text-on-surface-variant mt-1">Your department faculty can assign you as their mentee from the faculty dashboard.</p>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script>
        function toggleStudentUserMenu(event) {
            event.stopPropagation();
            const menu = document.getElementById('studentUserMenu');
            if (menu) {
                menu.classList.toggle('hidden');
            }
        }
        document.addEventListener('click', () => {
            const menu = document.getElementById('studentUserMenu');
            if (menu && !menu.classList.contains('hidden')) {
                menu.classList.add('hidden');
            }
        });
    </script>
</body>
</html>
