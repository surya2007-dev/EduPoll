<%- include('partials/head') %>
<body class="bg-background min-h-screen">
    <!-- Navigation Partials -->
    <%- include('partials/sidebar') %>
    <%- include('partials/header') %>

    <!-- Main Content Canvas -->
    <main class="pt-24 pb-20 px-margin-mobile md:px-margin-desktop lg:pl-[280px] min-h-screen flex items-center justify-center">
        <!-- Form Card Container -->
        <section class="w-full max-w-2xl bg-white border border-outline-variant/30 rounded-2xl shadow-xl overflow-hidden p-0 hover-scale">
            <!-- Card Header -->
            <div class="px-8 py-5 border-b border-outline-variant/20 flex justify-between items-center bg-surface-container-low/50">
                <h3 class="text-lg font-bold text-on-surface flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">person_add</span> Register New Student
                </h3>
                <a href="/faculty/students" class="text-on-surface-variant hover:text-on-surface transition-all">
                    <span class="material-symbols-outlined">close</span>
                </a>
            </div>

            <!-- Registration Form -->
            <form class="p-8 space-y-6" id="registerForm" onsubmit="handleRegistration(event)">
                <!-- Personal Info Row -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div class="space-y-1">
                        <label class="font-label-md text-label-md text-on-surface-variant font-bold tracking-wide uppercase">Full Name *</label>
                        <input type="text" id="studentName" required class="w-full px-4 py-2.5 rounded-xl border border-outline-variant focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-body-md">
                    </div>
                    <div class="space-y-1">
                        <label class="font-label-md text-label-md text-on-surface-variant font-bold tracking-wide uppercase">Student SEC ID / Roll No. *</label>
                        <input type="text" id="studentSecId" required class="w-full px-4 py-2.5 rounded-xl border border-outline-variant focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-body-md">
                    </div>
                </div>

                <!-- Gender and Gmail Details Row -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div class="space-y-1">
                        <label class="font-label-md text-label-md text-on-surface-variant font-bold tracking-wide uppercase">Gender *</label>
                        <select id="studentGender" required class="w-full px-4 py-2.5 rounded-xl border border-outline-variant focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-body-md bg-white">
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>
                    </div>
                    <div class="space-y-1">
                        <label class="font-label-md text-label-md text-on-surface-variant font-bold tracking-wide uppercase">Gmail / Email Address *</label>
                        <input type="email" id="studentEmail" required class="w-full px-4 py-2.5 rounded-xl border border-outline-variant focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-body-md">
                    </div>
                </div>

                <!-- Academic Info Row -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-6">
                    <div class="col-span-2 space-y-1">
                        <label class="font-label-md text-label-md text-on-surface-variant font-bold tracking-wide uppercase">Department *</label>
                        <select id="studentDept" required class="w-full px-4 py-2.5 rounded-xl border border-outline-variant focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-body-md bg-white">
                            <option value="B.E. - Mechanical Engineering">B.E. - Mechanical Engineering</option>
                            <option value="B.E. - Electronics & Communication Engineering">B.E. - Electronics & Communication Engineering</option>
                            <option value="B.E. - Electrical & Electronics Engineering">B.E. - Electrical & Electronics Engineering</option>
                            <option value="B.E. - Computer Science & Engineering">B.E. - Computer Science & Engineering</option>
                            <option value="B.E. - Instrumentation & Controls Engineering">B.E. - Instrumentation & Controls Engineering</option>
                            <option value="B.Tech. - Information Technology">B.Tech. - Information Technology</option>
                            <option value="B.E. - Civil Engineering">B.E. - Civil Engineering</option>
                            <option value="B.E. - Electronics & Instrumentation Engineering">B.E. - Electronics & Instrumentation Engineering</option>
                            <option value="B.E. - Production Engineering">B.E. - Production Engineering</option>
                        </select>
                    </div>
                    <div class="space-y-1">
                        <label class="font-label-md text-label-md text-on-surface-variant font-bold tracking-wide uppercase">Year *</label>
                        <select id="studentYear" required class="w-full px-4 py-2.5 rounded-xl border border-outline-variant focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-body-md bg-white">
                            <option value="Year 1">Year 1</option>
                            <option value="Year 2">Year 2</option>
                            <option value="Year 3">Year 3</option>
                            <option value="Year 4">Year 4</option>
                        </select>
                    </div>
                    <div class="space-y-1">
                        <label class="font-label-md text-label-md text-on-surface-variant font-bold tracking-wide uppercase">Section *</label>
                        <select id="studentSection" required class="w-full px-4 py-2.5 rounded-xl border border-outline-variant focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-body-md bg-white">
                            <option value="A">A</option>
                            <option value="B">B</option>
                            <option value="C">C</option>
                            <option value="D">D</option>
                            <option value="E">E</option>
                            <option value="F">F</option>
                        </select>
                    </div>
                </div>

                <!-- Classroom Assignment -->
                <div class="space-y-1">
                    <label class="font-label-md text-label-md text-on-surface-variant font-bold tracking-wide uppercase">Assign Classroom</label>
                    <select id="studentClassroom" class="w-full px-4 py-2.5 rounded-xl border border-outline-variant focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-body-md bg-white">
                        <option value="">-- Choose Classroom --</option>
                        <% classrooms.forEach(room => { %>
                            <option value="<%= room._id %>"><%= room.name %> (<%= room.subject %>)</option>
                        <% }) %>
                    </select>
                </div>

                <!-- Password and Comments -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div class="space-y-1 relative">
                        <label class="font-label-md text-label-md text-on-surface-variant font-bold tracking-wide uppercase">Login Password *</label>
                        <div class="relative">
                            <input type="password" id="studentPass" required class="w-full px-4 py-2.5 rounded-xl border border-outline-variant focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-body-md">
                            <button type="button" onclick="togglePass()" class="absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant/50 hover:text-on-surface transition-all">
                                <span class="material-symbols-outlined text-sm" id="passIcon">visibility</span>
                            </button>
                        </div>
                    </div>
                    <div class="space-y-1">
                        <label class="font-label-md text-label-md text-on-surface-variant font-bold tracking-wide uppercase">Brief Notes / Remarks</label>
                        <input type="text" id="studentDesc" class="w-full px-4 py-2.5 rounded-xl border border-outline-variant focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-body-md">
                    </div>
                </div>

                <!-- Error / Success Banners -->
                <div id="errorBanner" class="hidden text-error bg-error-container/30 border border-error/20 p-3 rounded-xl text-sm text-center font-medium"></div>
                <div id="successBanner" class="hidden text-green-700 bg-green-100 border border-green-200 p-3 rounded-xl text-sm text-center font-medium"></div>

                <!-- Actions Footer -->
                <div class="flex justify-end items-center gap-3 pt-6 border-t border-outline-variant/20">
                    <a href="/faculty/students" class="px-5 py-2.5 border border-outline-variant text-on-surface-variant font-semibold rounded-xl hover:bg-surface-container transition-all">Cancel</a>
                    <button type="submit" class="px-5 py-2.5 bg-primary text-white font-semibold rounded-xl hover:brightness-110 active:scale-95 transition-all shadow-md">Register Student</button>
                </div>
            </form>
        </section>
    </main>

    <script>
        function togglePass() {
            const pass = document.getElementById('studentPass');
            const icon = document.getElementById('passIcon');
            if (pass.type === 'password') {
                pass.type = 'text';
                icon.innerText = 'visibility_off';
            } else {
                pass.type = 'password';
                icon.innerText = 'visibility';
            }
        }

        async function handleRegistration(e) {
            e.preventDefault();
            const name = document.getElementById('studentName').value.trim();
            const secId = document.getElementById('studentSecId').value.trim();
            const department = document.getElementById('studentDept').value;
            const year = document.getElementById('studentYear').value;
            const section = document.getElementById('studentSection').value.trim();
            const classroom = document.getElementById('studentClassroom').value;
            const password = document.getElementById('studentPass').value;
            const description = document.getElementById('studentDesc').value.trim();
            const gender = document.getElementById('studentGender').value;
            const email = document.getElementById('studentEmail').value.trim();

            const errorBanner = document.getElementById('errorBanner');
            const successBanner = document.getElementById('successBanner');
            errorBanner.classList.add('hidden');
            successBanner.classList.add('hidden');

            try {
                const response = await fetch('/api/students/register', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, secId, year, section, department, classroom, description, password, gender, email })
                });

                if (response.ok) {
                    successBanner.innerText = `Student ${name} successfully registered. Redirecting...`;
                    successBanner.classList.remove('hidden');
                    setTimeout(() => {
                        window.location.href = '/faculty/students';
                    }, 1500);
                } else {
                    const data = await response.json();
                    errorBanner.innerText = data.error || 'Student registration failed.';
                    errorBanner.classList.remove('hidden');
                }
            } catch(err) {
                console.error(err);
                errorBanner.innerText = 'Connection error. Please try again.';
                errorBanner.classList.remove('hidden');
            }
        }
    </script>
</body>
</html>
