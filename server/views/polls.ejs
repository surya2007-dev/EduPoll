<%- include('partials/head') %>
<body class="bg-background min-h-screen">
    <!-- Navigation Partials -->
    <%- include('partials/sidebar') %>
    <%- include('partials/header') %>

    <!-- Main Canvas -->
    <main class="pt-24 pb-20 px-margin-mobile md:px-margin-desktop lg:pl-[280px] min-h-screen">
        <div class="max-w-[1440px] mx-auto w-full space-y-xl animate-fade-in">
            <!-- Header Section -->
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                <div>
                    <h3 class="font-headline-lg text-headline-lg text-on-surface">Manage Polls</h3>
                    <p class="text-on-surface-variant font-body-md">Create new classroom interactive polls and audit results history</p>
                </div>
                <a href="/faculty/polls/create" class="flex items-center gap-2 px-5 py-2.5 bg-primary text-white rounded-xl font-bold shadow-md hover:shadow-lg active:scale-95 transition-all hover:scale-105">
                    <span class="material-symbols-outlined text-sm">add</span> Create New Poll
                </a>
            </div>

            <!-- Toolbar Filters -->
            <div class="p-4 bg-white border border-outline-variant/30 rounded-2xl flex flex-col sm:flex-row gap-4 justify-between items-center shadow-sm">
                <!-- Status Filter Buttons -->
                <div class="flex gap-2 w-full sm:w-auto">
                    <button onclick="setStatusFilter('ALL', this)" class="px-4 py-2 text-sm font-semibold rounded-xl bg-primary-container text-on-primary-container transition-all" id="btn-filter-all">
                        All Polls
                    </button>
                    <button onclick="setStatusFilter('live', this)" class="px-4 py-2 text-sm font-semibold rounded-xl text-on-surface-variant hover:bg-surface-container-high transition-all" id="btn-filter-live">
                        Active Now
                    </button>
                    <button onclick="setStatusFilter('completed', this)" class="px-4 py-2 text-sm font-semibold rounded-xl text-on-surface-variant hover:bg-surface-container-high transition-all" id="btn-filter-completed">
                        Completed
                    </button>
                </div>

                <!-- Classroom Select Filter -->
                <div class="flex items-center gap-2 w-full sm:w-auto">
                    <label class="text-xs font-bold uppercase tracking-wider text-on-surface-variant shrink-0">Classroom:</label>
                    <select id="classroomSelect" onchange="filterPolls()" class="w-full sm:w-48 px-3 py-2 rounded-xl border border-outline-variant/50 bg-white text-body-md focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all">
                        <option value="ALL">All Classrooms</option>
                        <% classrooms.forEach(room => { %>
                            <option value="<%= room.name %>"><%= room.name %></option>
                        <% }) %>
                    </select>
                </div>
            </div>

            <!-- Poll Cards Listing -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter" id="pollsContainer">
                <% if (polls.length === 0) { %>
                    <div class="col-span-full text-center py-12 flex flex-col items-center gap-4 bg-white rounded-2xl border border-outline-variant/30">
                        <span class="material-symbols-outlined text-[48px] text-on-surface-variant/30">poll</span>
                        <div>
                            <h5 class="text-lg font-bold text-on-surface">No Polls Found</h5>
                            <p class="text-on-surface-variant text-sm mt-1">Create an interactive poll to launch live questions in class.</p>
                        </div>
                        <a href="/faculty/polls/create" class="px-5 py-2 bg-primary text-white font-bold rounded-xl shadow-sm hover:brightness-110 active:scale-95 transition-all text-sm">
                            Launch Poll
                        </a>
                    </div>
                <% } else { %>
                    <% polls.forEach(poll => { %>
                        <div class="poll-card bg-white rounded-2xl border border-outline-variant/30 p-6 flex flex-col justify-between shadow-sm hover-scale relative" data-status="<%= poll.status %>" data-classroom="<%= poll.classroom.name %>">
                            <!-- Status Badges -->
                            <div class="absolute top-4 right-4 flex items-center gap-2">
                                <% if (poll.status === 'live') { %>
                                    <span class="px-2.5 py-0.5 bg-error-container text-on-error-container rounded-full text-[10px] font-bold uppercase animate-pulse">LIVE</span>
                                <% } else { %>
                                    <span class="px-2.5 py-0.5 bg-surface-container text-on-surface-variant rounded-full text-[10px] font-bold uppercase">COMPLETED</span>
                                <% } %>
                                
                                <button onclick="deletePoll('<%= poll._id %>')" class="p-1 text-on-surface-variant hover:text-error hover:bg-error-container/20 rounded transition-all">
                                    <span class="material-symbols-outlined text-sm">delete</span>
                                </button>
                            </div>

                            <div class="space-y-3 pr-12">
                                <div class="flex items-center gap-2">
                                    <span class="px-2 py-0.5 bg-surface-container rounded border border-outline-variant/20 font-mono text-[10px] font-bold text-on-surface-variant"><%= poll.classroom.name %></span>
                                    <span class="text-xs text-outline font-medium uppercase"><%= poll.type %></span>
                                </div>
                                <h4 class="text-lg font-bold text-on-surface leading-snug"><%= poll.question %></h4>
                            </div>

                            <!-- Options List Preview -->
                            <div class="mt-4 space-y-sm">
                                <p class="text-[10px] uppercase font-bold text-on-surface-variant/70">Options Preview</p>
                                <div class="grid grid-cols-2 gap-2 text-xs">
                                    <% poll.options.forEach((opt, idx) => { %>
                                        <div class="px-2.5 py-1.5 bg-surface-container-low border border-outline-variant/10 rounded flex items-center gap-1.5">
                                            <span class="w-4 h-4 rounded-full bg-outline-variant/40 flex items-center justify-center font-bold text-[9px]"><%= idx+1 %></span>
                                            <span class="truncate font-medium text-on-surface-variant"><%= opt %></span>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>

                            <div class="mt-6 pt-4 border-t border-outline-variant/20 flex justify-between items-center">
                                <div class="text-xs text-on-surface-variant font-medium flex items-center gap-1">
                                    <span class="material-symbols-outlined text-sm">schedule</span>
                                    <%= new Date(poll.createdAt).toLocaleDateString() %>
                                </div>
                                <div class="text-xs font-bold text-primary flex items-center gap-1">
                                    <span class="material-symbols-outlined text-sm">verified</span>
                                    <%= poll.responses.length %> / <%= poll.targetStudents.length %> Responses
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } %>
            </div>
        </div>
    </main>

    <!-- Delete Poll Modal Backdrop -->
    <div id="deletePollModal" class="fixed inset-0 overflow-y-auto z-50 hidden" role="dialog" aria-modal="true">
        <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
            <div onclick="toggleDeleteModal(false)" class="fixed inset-0 bg-inverse-surface/30 backdrop-blur-sm transition-opacity" aria-hidden="true"></div>
            <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

            <div class="inline-block align-bottom bg-white rounded-2xl text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-md sm:w-full border border-outline-variant/30">
                <div class="px-6 py-4 border-b border-outline-variant/20 flex justify-between items-center bg-error-container/10">
                    <h3 class="text-lg font-bold text-error flex items-center gap-2">
                        <span class="material-symbols-outlined">warning</span> Verify Poll Deletion
                    </h3>
                    <button onclick="toggleDeleteModal(false)" class="rounded-md text-on-surface-variant hover:text-on-surface outline-none">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>

                <div class="p-6 space-y-4">
                    <p class="text-sm text-on-surface-variant leading-relaxed">
                        Are you sure you want to permanently delete this classroom poll entry? This will delete all student response results. This action cannot be undone.
                    </p>
                    <input type="hidden" id="deletePollId">
                </div>

                <div class="flex justify-end items-center gap-3 p-6 border-t border-outline-variant/20">
                    <button onclick="toggleDeleteModal(false)" class="px-5 py-2.5 border border-outline-variant text-on-surface-variant font-semibold rounded-xl hover:bg-surface-container transition-all">Cancel</button>
                    <button onclick="executePollDelete()" class="px-5 py-2.5 bg-error text-white font-semibold rounded-xl hover:brightness-110 active:scale-95 transition-all shadow-md">Confirm Delete</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        let currentStatusFilter = 'ALL';

        function setStatusFilter(status, btn) {
            currentStatusFilter = status;
            
            // Adjust button style highlighting
            const filterButtons = [
                { key: 'ALL', id: 'btn-filter-all' },
                { key: 'live', id: 'btn-filter-live' },
                { key: 'completed', id: 'btn-filter-completed' }
            ];

            filterButtons.forEach(f => {
                const el = document.getElementById(f.id);
                if (f.key === status) {
                    el.className = "px-4 py-2 text-sm font-semibold rounded-xl bg-primary-container text-on-primary-container transition-all";
                } else {
                    el.className = "px-4 py-2 text-sm font-semibold rounded-xl text-on-surface-variant hover:bg-surface-container-high transition-all";
                }
            });

            filterPolls();
        }

        function filterPolls() {
            const classroom = document.getElementById('classroomSelect').value;
            const cards = document.querySelectorAll('.poll-card');

            cards.forEach(card => {
                const status = card.getAttribute('data-status');
                const rowClassroom = card.getAttribute('data-classroom');

                const matchesStatus = currentStatusFilter === 'ALL' || status === currentStatusFilter;
                const matchesClassroom = classroom === 'ALL' || rowClassroom === classroom;

                if (matchesStatus && matchesClassroom) {
                    card.style.display = '';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        function toggleDeleteModal(open) {
            const modal = document.getElementById('deletePollModal');
            modal.classList.toggle('hidden', !open);
        }

        function deletePoll(id) {
            document.getElementById('deletePollId').value = id;
            toggleDeleteModal(true);
        }

        async function executePollDelete() {
            const id = document.getElementById('deletePollId').value;
            toggleDeleteModal(false);
            try {
                const res = await fetch(`/api/polls/${id}`, { method: 'DELETE' });
                if (res.ok) {
                    window.location.reload();
                } else {
                    alert('Failed to delete poll.');
                }
            } catch(e) {
                console.error(e);
            }
        }
    </script>
</body>
</html>
