# EduPoll Backend Environment Configuration Example
# Copy this file to .env and configure values for your environment.

# Port for the Express server (Default: 3000)
PORT=3000

# MongoDB Connection URI (Local or Atlas Cloud)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Secret key for signing express-session cookies (Generate a strong random secret at least 32 characters)
SESSION_SECRET=<generate-a-cryptographically-random-secret-at-least-32-characters>

# Required only when running npm run bootstrap-admin
BOOTSTRAP_ADMIN_SEC_ID=<admin-id>
BOOTSTRAP_ADMIN_NAME=<admin-name>
BOOTSTRAP_ADMIN_EMAIL=<admin-email>
BOOTSTRAP_ADMIN_PASSWORD=<strong-one-time-bootstrap-password-min-12-chars>

# Runtime Environment Mode (development | production)
NODE_ENV=development

# Authorized Application Origin (used by CSRF middleware)
APP_ORIGIN=http://localhost:3000

